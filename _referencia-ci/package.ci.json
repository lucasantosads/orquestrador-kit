{
  "name": "conteudos-infinitos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Engine de Conteúdo (Máquina de Roteiros) — jurídico (M1–M8)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "npm run typecheck:root && npm run typecheck:web",
    "typecheck:root": "tsc --noEmit",
    "typecheck:web": "npm --prefix apps/web run typecheck",
    "test": "vitest run",
    "test:web": "npm --prefix apps/web run test",
    "test:watch": "vitest",
    "test:e2e": "RUN_DB_E2E=1 vitest run",
    "build:web": "npm --prefix apps/web run build",
    "smoke": "npx tsx scripts/smoke/smoke-staging.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
