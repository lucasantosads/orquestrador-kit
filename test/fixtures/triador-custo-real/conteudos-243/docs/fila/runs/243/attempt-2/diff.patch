+// Ticket 243 — tela pública do link de aprovação: quem tem o link vê UM roteiro e responde.
+// Sem layout próprio, sem menu, sem link para outra tela. Link inexistente, vencido ou cancelado
+// caem todos no mesmo notFound(): a tela não reintroduz a distinção que o servidor tirou.
+// O token vive na URL e no campo escondido que a ação recebe; nunca em texto, atributo de
+// acessibilidade ou console.
+
+import type { Metadata } from 'next'
+import { notFound } from 'next/navigation'
+import { decidirPorToken, lerRoteiroPorToken } from '@/server/aprovacoes-publico'
+
+export const dynamic = 'force-dynamic'
+
+// O layout raiz fala do painel interno; aqui o título diz só o que a tela é.
+export const metadata: Metadata = { title: 'Roteiro para aprovação', description: '' }
+
+// O layout raiz monta a barra do app em toda rota e ela não se esconde aqui (Nav.tsx e layout.tsx
+// ficam fora deste ticket). Até ela aprender a rota, esta tela a esconde por conta própria.
+const ESCONDE_BARRA_DO_APP = 'body > header { display: none !important; }'
+
+async function aprovar(formData: FormData) {
+  'use server'
+  const token = String(formData.get('token') ?? '')
+  if (token === '') return
+  await decidirPorToken(token, 'aprovado')
+}
+
+async function pedirAjuste(formData: FormData) {
+  'use server'
+  const token = String(formData.get('token') ?? '')
+  const comentario = String(formData.get('comentario') ?? '').trim()
+  if (token === '' || comentario === '') return
+  await decidirPorToken(token, 'ajuste_pedido', comentario)
+}
+
+export default async function AprovarPage({ params }: { params: Promise<{ token: string }> }) {
+  const { token } = await params
+  const roteiro = await lerRoteiroPorToken(token)
+  if (!roteiro) notFound()
+
+  return (
+    <main style={{ maxWidth: 720, margin: '0 auto', padding: '32px 16px' }}>
+      <style>{ESCONDE_BARRA_DO_APP}</style>
+      <section>
+        <h1>Roteiro</h1>
+        <h2>{roteiro.gancho}</h2>
+        <p style={{ whiteSpace: 'pre-wrap' }}>{roteiro.corpo}</p>
+      </section>
+
+      <section>
+        <h2>Legenda</h2>
+        <p style={{ whiteSpace: 'pre-wrap' }}>{roteiro.legenda}</p>
+        {roteiro.hashtags.length > 0 && <p>{roteiro.hashtags.join(' ')}</p>}
+      </section>
+
+      <section>
+        <h2>Checagem do Provimento 205</h2>
+        <p>{roteiro.veredito}</p>
+      </section>
+
+      {roteiro.estado === 'pendente' ? (
+        <section>
+          <form action={aprovar}>
+            <input type="hidden" name="token" value={token} />
+            <button type="submit">Aprovar</button>
+          </form>
+
+          <form action={pedirAjuste}>
+            <input type="hidden" name="token" value={token} />
+            <label htmlFor="comentario">O que precisa ser ajustado?</label>
+            <textarea id="comentario" name="comentario" required rows={4} />
+            <button type="submit">Pedir ajuste</button>
+          </form>
+        </section>
+      ) : (
+        <section>
+          <h2>Sua resposta</h2>
+          <p>{roteiro.estado === 'aprovado' ? 'Roteiro aprovado.' : 'Ajuste pedido.'}</p>
+          {roteiro.comentario && <p style={{ whiteSpace: 'pre-wrap' }}>{roteiro.comentario}</p>}
+        </section>
+      )}
+    </main>
+  )
+}
