diff --git a/apps/web/test/aprovar-publico.test.tsx b/apps/web/test/aprovar-publico.test.tsx
new file mode 100644
index 0000000..a8c5f22
--- /dev/null
+++ b/apps/web/test/aprovar-publico.test.tsx
@@ -0,0 +1,159 @@
+// Ticket 243 — a rota pública /aprovar/<token>: classe pública provada nos DOIS níveis (função pura
+// e request sem sessão atravessando updateSession, no padrão de briefing-gate.test.ts) e a tela
+// renderizada (o que mostra e o que não pode mostrar). Segredo de teste nasce em tempo de execução.
+
+import { describe, it, expect, beforeEach, vi } from 'vitest'
+import { NextRequest } from 'next/server'
+import { randomBytes } from 'node:crypto'
+import { renderToStaticMarkup } from 'react-dom/server'
+import { isPublicPath, isAuthScreen } from '../src/lib/auth/routes'
+
+const TOKEN = randomBytes(16).toString('hex')
+
+let mockUser: { id: string } | null = null
+let membershipCalls = 0
+let personaCalls = 0
+let mockRoteiro: Record<string, unknown> | null = null
+const notFoundMock = vi.fn(() => {
+  throw new Error('NEXT_NOT_FOUND')
+})
+const lerMock = vi.fn(async (_t: string) => mockRoteiro)
+
+vi.mock('@supabase/ssr', () => ({
+  createServerClient: () => ({
+    auth: {
+      getUser: async () => ({ data: { user: mockUser } }),
+    },
+    from: (table: string) => {
+      if (table === 'organization_members') {
+        membershipCalls++
+        return {
+          select: () => ({
+            eq: () => ({
+              order: () => ({
+                limit: () => ({
+                  maybeSingle: async () => ({ data: null }),
+                }),
+              }),
+            }),
+          }),
+        }
+      }
+      if (table === 'personas') {
+        personaCalls++
+        return { select: () => ({ eq: async () => ({ count: 0 }) }) }
+      }
+      throw new Error(`tabela inesperada: ${table}`)
+    },
+  }),
+}))
+
+vi.mock('server-only', () => ({}))
+vi.mock('next/navigation', () => ({ notFound: () => notFoundMock() }))
+vi.mock('@/server/aprovacoes-publico', () => ({
+  lerRoteiroPorToken: (t: string) => lerMock(t),
+  decidirPorToken: vi.fn(),
+}))
+
+const { updateSession } = await import('../src/lib/supabase/middleware')
+const { default: AprovarPage } = await import('../src/app/aprovar/[token]/page')
+
+function req(pathname: string) {
+  return new NextRequest(new URL(pathname, 'https://app.example.com'))
+}
+
+async function render() {
+  return renderToStaticMarkup(await AprovarPage({ params: Promise.resolve({ token: TOKEN }) }))
+}
+
+const roteiroValido = {
+  gancho: 'Gancho do roteiro de teste',
+  corpo: 'Corpo do roteiro de teste',
+  legenda: 'Legenda de teste',
+  hashtags: ['#direito', '#advocacia'],
+  veredito: 'Aprovado no Provimento 205',
+  estado: 'pendente',
+  comentario: null,
+}
+
+beforeEach(() => {
+  mockUser = null
+  membershipCalls = 0
+  personaCalls = 0
+  mockRoteiro = { ...roteiroValido }
+  notFoundMock.mockClear()
+  lerMock.mockClear()
+})
+
+describe('ticket 243 — classe pública nos dois níveis', () => {
+  it('função pura: /aprovar/<token> é público, não é tela de auth, e /aprovacoes é protegida', () => {
+    expect(isPublicPath('/aprovar')).toBe(true)
+    expect(isPublicPath(`/aprovar/${TOKEN}`)).toBe(true)
+    expect(isAuthScreen(`/aprovar/${TOKEN}`)).toBe(false)
+    expect(isPublicPath('/aprovacoes')).toBe(false)
+  })
+
+  it('sem sessão, /aprovar/<token> atravessa updateSession sem redirecionar para /login', async () => {
+    const res = await updateSession(req(`/aprovar/${TOKEN}`))
+    expect(res.headers.get('location')).toBeNull()
+  })
+
+  it('sem sessão, /aprovacoes (fila interna) redireciona para /login', async () => {
+    const res = await updateSession(req('/aprovacoes'))
+    expect(res.headers.get('location') ?? '').toContain('/login')
+  })
+
+  it('sem sessão, /aprovar não dispara consulta de organization_members nem de personas', async () => {
+    await updateSession(req(`/aprovar/${TOKEN}`))
+    expect(membershipCalls).toBe(0)
+    expect(personaCalls).toBe(0)
+  })
+})
+
+describe('ticket 243 — a tela do link', () => {
+  it('com roteiro válido mostra gancho, corpo, legenda, hashtags e veredito, e os dois caminhos de resposta', async () => {
+    const html = await render()
+    expect(lerMock).toHaveBeenCalledWith(TOKEN)
+    expect(html).toContain('Gancho do roteiro de teste')
+    expect(html).toContain('Corpo do roteiro de teste')
+    expect(html).toContain('Legenda de teste')
+    expect(html).toContain('#direito #advocacia')
+    expect(html).toContain('Aprovado no Provimento 205')
+    expect(html).toContain('Aprovar')
+    expect(html).toContain('Pedir ajuste')
+  })
+
+  it('com lerRoteiroPorToken devolvendo nulo chama notFound, sem mensagem própria', async () => {
+    mockRoteiro = null
+    await expect(render()).rejects.toThrow('NEXT_NOT_FOUND')
+    expect(notFoundMock).toHaveBeenCalledTimes(1)
+  })
+
+  it('não mostra persona, ângulo, score nem link para outra tela', async () => {
+    const html = await render()
+    expect(html).not.toMatch(/persona|[aâ]ngulo|score|menu|dashboard/i)
+    expect(html).not.toMatch(/<a[\s>]/i)
+    expect(html).not.toMatch(/href=/i)
+  })
+
+  it('esconde a barra do app que o layout raiz monta em toda rota', async () => {
+    const html = await render()
+    expect(html).toMatch(/<style>body &gt; header \{ display: none !important; \}<\/style>|<style>body > header \{ display: none !important; \}<\/style>/)
+  })
+
+  it('o token só aparece no campo escondido da ação, nunca em texto visível nem em rótulo', async () => {
+    const html = await render()
+    const semCampos = html.replace(/<input type="hidden"[^>]*>/gi, '')
+    expect(semCampos).not.toContain(TOKEN)
+    expect(html).not.toMatch(/aria-[a-z]+="[^"]*/i)
+  })
+
+  it('link já respondido mostra o estado e o comentário e não oferece os botões de novo', async () => {
+    mockRoteiro = { ...roteiroValido, estado: 'ajuste_pedido', comentario: 'Trocar o gancho' }
+    const html = await render()
+    expect(html).toContain('Ajuste pedido')
+    expect(html).toContain('Trocar o gancho')
+    expect(html).not.toMatch(/<button/i)
+    expect(html).not.toMatch(/<textarea/i)
+  })
+})
