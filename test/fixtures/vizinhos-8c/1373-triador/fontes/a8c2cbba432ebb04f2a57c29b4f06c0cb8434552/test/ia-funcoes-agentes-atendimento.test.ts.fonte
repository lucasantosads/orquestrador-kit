import { describe, it, expect } from 'vitest'
import { readFileSync } from 'node:fs'
import { join } from 'node:path'
import { IA_FUNCOES, getFuncaoDef } from '@/lib/ia/funcoes'

const NOVAS = [
  'critica_mensagem_comercial',
  'agente_atendimento_montar',
  'agente_atendimento_responder',
  'agente_atendimento_avaliar',
]

describe('agentes de atendimento: funções de IA no registro', () => {
  it('as 4 funções novas existem com label e descrição não vazios', () => {
    for (const funcao of NOVAS) {
      const def = getFuncaoDef(funcao)
      expect(def).toBeDefined()
      expect(def?.label.trim().length).toBeGreaterThan(0)
      expect(def?.descricao.trim().length).toBeGreaterThan(0)
    }
  })

  it('IA_FUNCOES não repete funcao', () => {
    const nomes = IA_FUNCOES.map((f) => f.funcao)
    expect(new Set(nomes).size).toBe(nomes.length)
  })

  it('as 4 novas ficam no fim do registro, na ordem pedida', () => {
    expect(IA_FUNCOES.slice(-4).map((f) => f.funcao)).toEqual(NOVAS)
  })

  it('as funções que já existiam continuam presentes', () => {
    for (const funcao of ['motivo_desistencia_comercial', 'followup_comercial', 'dossie_extracao', 'roteiros_criativo']) {
      expect(getFuncaoDef(funcao)).toBeDefined()
    }
  })

  it('nenhum texto do registro usa travessão (U+2014)', () => {
    const src = readFileSync(join(__dirname, '..', 'src/lib/ia/funcoes.ts'), 'utf-8')
    expect(src.includes(String.fromCharCode(0x2014))).toBe(false)
    for (const f of IA_FUNCOES) {
      expect(`${f.label} ${f.descricao}`.includes(String.fromCharCode(0x2014))).toBe(false)
    }
  })

  it('as 4 entradas novas não citam provedor nem modelo', () => {
    for (const funcao of NOVAS) {
      const def = getFuncaoDef(funcao)
      const texto = JSON.stringify(def).toLowerCase()
      for (const termo of ['openai', 'gpt', 'claude', 'gemini']) {
        expect(texto.includes(termo)).toBe(false)
      }
      expect(Object.keys(def ?? {}).sort()).toEqual(['descricao', 'funcao', 'label'])
    }
  })
})
