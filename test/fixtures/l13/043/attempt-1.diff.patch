+import { describe, expect, it } from "vitest";
+import { lerValorDigitado, previaRateio, textoSituacao } from "../mds-util";
+
+describe("lerValorDigitado", () => {
+  it.each(["7.500,00", "7500,00", "7500.00", " R$ 7.500,00 ", "7500"])("aceita %j como 7500", (t) => {
+    expect(lerValorDigitado(t)).toEqual({ ok: true, valor: 7500 });
+  });
+  it("mantém os centavos", () => {
+    expect(lerValorDigitado("1.234,5")).toEqual({ ok: true, valor: 1234.5 });
+    expect(lerValorDigitado("0,01")).toEqual({ ok: true, valor: 0.01 });
+  });
+  it.each(["", "abc", "7500,001", "7500.001", "1,2,3", "7.50,00", "0", "0,00", "-5"])("recusa %j", (t) => {
+    expect(lerValorDigitado(t).ok).toBe(false);
+  });
+});
+
+describe("previaRateio", () => {
+  const clientes = [
+    { nome: "A", valor_mensal: 1000 },
+    { nome: "B", valor_mensal: 1000 },
+    { nome: "C", valor_mensal: 1000 },
+  ];
+  it("soma igual ao valor digitado, ao centavo, com o resto no último", () => {
+    const r = previaRateio(100, clientes);
+    expect(r.map((x) => x.parte)).toEqual([33.33, 33.33, 33.34]);
+    expect(Math.round(r.reduce((s, x) => s + x.parte, 0) * 100)).toBe(10000);
+  });
+  it("é proporcional à mensalidade e preserva a ordem recebida", () => {
+    const r = previaRateio(7500, [
+      { nome: "X", valor_mensal: 1000 },
+      { nome: "Y", valor_mensal: 3000 },
+      { nome: "Z", valor_mensal: 1000 },
+    ]);
+    expect(r).toEqual([{ nome: "X", parte: 1500 }, { nome: "Y", parte: 4500 }, { nome: "Z", parte: 1500 }]);
+  });
+  it("soma fecha em valores quebrados", () => {
+    const cs = Array.from({ length: 15 }, (_, i) => ({ nome: `C${i}`, valor_mensal: 333.33 + i * 17.17 }));
+    const r = previaRateio(7499.99, cs);
+    expect(r).toHaveLength(15);
+    expect(Math.round(r.reduce((s, x) => s + x.parte, 0) * 100)).toBe(749999);
+  });
+  it("sem clientes ou sem mensalidade não inventa rateio", () => {
+    expect(previaRateio(100, [])).toEqual([]);
+    expect(previaRateio(100, [{ nome: "A", valor_mensal: 0 }])).toEqual([]);
+  });
+});
+
+describe("textoSituacao", () => {
+  it("com bloco", () => {
+    expect(textoSituacao({ valor: 7500, data_recebimento: "2026-11-05", clientes: 15 })).toBe("Pago em 05/11: R$ 7.500,00 para 15 clientes");
+  });
+  it("com um cliente só, no singular", () => {
+    expect(textoSituacao({ valor: 500, data_recebimento: "2026-11-05", clientes: 1 })).toBe("Pago em 05/11: R$ 500,00 para 1 cliente");
+  });
+  it("sem bloco", () => {
+    expect(textoSituacao(null)).toBe("Pagamento da MDS ainda não registrado");
+  });
+});
