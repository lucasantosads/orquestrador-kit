+/**
+ * GET /api/financeiro-v2/analise/closers?mes=YYYY-MM
+ * Visão por closer do mês: carteira, recebido, saídas e comissão. Falha de leitura da base = 503;
+ * falha da comissão não derruba a rota (vai em `comissao: { ok: false }`, comissão null por linha).
+ * SOMENTE LEITURA: só select. Acesso: sessão + permissão de financeiro no servidor.
+ */
+import { NextRequest, NextResponse } from "next/server";
+import { calcularComissao, type ComissaoResult } from "@/lib/comissao-canonica";
+import { calcularPorCloser, lerBaseCloser } from "@/lib/financeiro/v2/por-closer";
+import { autorizar, mesPedido } from "@/lib/financeiro/v2/servidor";
+import type { Leitura } from "@/lib/financeiro/v2/tipos";
+
+export const dynamic = "force-dynamic";
+export const maxDuration = 60;
+
+const SEM_CACHE = { "Cache-Control": "no-store" };
+
+const FONTE = {
+  regra: "Cliente é do closer de mesmo nome em clientes_receita.closer. Ativos e MRR pelo status financeiro ativo; recebido por pagamentos pagos ou parciais do mês; saídas pelo churn_log do mês (não revertido); comissão pela comissao-canonica. Diretor fora do ranking; ex-closer em carteira herdada.",
+  tabelas: ["closers", "employees", "clientes_receita", "pagamentos_mensais", "churn_log"],
+};
+
+export async function GET(req: NextRequest) {
+  const a = await autorizar();
+  if (!a.ok) return NextResponse.json({ ok: false, erro: a.erro }, { status: a.status, headers: SEM_CACHE });
+  const mes = mesPedido(req.nextUrl.searchParams.get("mes"), a.hoje);
+  if (!mes) return NextResponse.json({ ok: false, erro: "Mês inválido." }, { status: 400, headers: SEM_CACHE });
+
+  const base = await lerBaseCloser(a.db, mes);
+  if (!base.ok) return NextResponse.json({ ok: false, erro: base.falha }, { status: 503, headers: SEM_CACHE });
+
+  let comissao: Leitura<ComissaoResult>;
+  try {
+    comissao = { ok: true, dados: await calcularComissao({ mes_referencia: mes }) };
+  } catch (e) {
+    comissao = { ok: false, falha: `comissão sem leitura: ${e instanceof Error ? e.message : String(e)}` };
+  }
+
+  return NextResponse.json(
+    { ok: true, mes, ...calcularPorCloser(base.dados, comissao), fonte: { ...FONTE, lidoEm: a.hoje.iso } },
+    { headers: SEM_CACHE },
+  );
+}
