+
+const colab = (p: Partial<ComissaoColaborador>): ComissaoColaborador =>
+  ({ recebe_comissao: true, meta_pct: null, faixa_aplicada: null, fonte: "t", snapshot_aplicado: false, comissao_total: 0, ...p }) as ComissaoColaborador;
+
+const resultado = (colaboradores: ComissaoColaborador[], mes_fechado = false): ComissaoResult =>
+  ({ mes_referencia: "2026-10", colaboradores, mes_fechado, totais: { comissao_closers: 0, comissao_sdrs: 0, comissao_total: 0, contratos_novos_total: 0, renovacoes_total: 0 } });
+
+const ok = (r: ComissaoResult): Leitura<ComissaoResult> => ({ ok: true, dados: r });
+const semComissao: Leitura<ComissaoResult> = { ok: false, falha: "comissão sem leitura: x" };
+
+// ─── Banco falso (só leitura) ───────────────────────────────────────────────
+
+type Filtro = { op: "eq" | "gte" | "lte"; col: string; val: unknown };
+
+function bancoFalso(tabelas: Record<string, Record<string, unknown>[]>, falhaEm?: string) {
+  const reg = { filtros: {} as Record<string, Filtro[]>, selects: {} as Record<string, string>, escritas: 0 };
+  const db = {
+    from(tabela: string) {
+      const filtros: Filtro[] = [];
+      reg.filtros[tabela] = filtros;
+      let de = 0, ate = 999;
+      const b: Record<string, unknown> = {
+        select: (cols: string) => { reg.selects[tabela] = cols; return b; },
+        eq: (col: string, val: unknown) => { filtros.push({ op: "eq", col, val }); return b; },
+        gte: (col: string, val: unknown) => { filtros.push({ op: "gte", col, val }); return b; },
+        lte: (col: string, val: unknown) => { filtros.push({ op: "lte", col, val }); return b; },
+        order: () => b,
+        range: (a: number, z: number) => { de = a; ate = z; return b; },
+        insert: () => { reg.escritas++; return b; },
+        update: () => { reg.escritas++; return b; },
+        upsert: () => { reg.escritas++; return b; },
+        delete: () => { reg.escritas++; return b; },
+        then: (res: (v: unknown) => unknown, rej?: (e: unknown) => unknown) => {
+          if (tabela === falhaEm) return Promise.resolve({ data: null, error: { message: "boom" } }).then(res, rej);
+          const linhas = (tabelas[tabela] ?? []).filter((r) => filtros.every((f) => {
+            const v = r[f.col] as string | boolean;
+            return f.op === "eq" ? v === f.val : f.op === "gte" ? String(v) >= String(f.val) : String(v) <= String(f.val);
+          }));
+          return Promise.resolve({ data: linhas.slice(de, ate + 1), error: null }).then(res, rej);
+        },
+      };
+      return b;
+    },
+    rpc: () => { reg.escritas++; },
+  };
+  return { db: db as unknown as SupabaseClient, reg };
+}
+
+const tabelasDe = (b: BaseCloser) => ({
+  closers: b.closers as unknown as Record<string, unknown>[],
+  employees: b.employees as unknown as Record<string, unknown>[],
+  clientes_receita: b.clientes as unknown as Record<string, unknown>[],
+  pagamentos_mensais: b.pagamentos.map((p) => ({ ...p, mes_referencia: "2026-10-01" })),
+  churn_log: b.churn.map((c) => ({ ...c, revertido: false })),
+});
+
+// ─── Testes ─────────────────────────────────────────────────────────────────
+
+describe("calcularPorCloser: dono, diretor, ex-closer", () => {
+  const r = calcularPorCloser(base(), semComissao);
+
+  it("controle da fixture: sem a regra de diretor, Lucas lideraria o ranking por recebido", () => {
+    const b = base();
+    const recebidoDoLucas = b.pagamentos.filter((p) => p.cliente_id === "c1").reduce((s, p) => s + (p.valor_pago ?? 0), 0);
+    expect(recebidoDoLucas).toBe(5000);
+    expect(r.ranking[0].recebido).toBeLessThan(recebidoDoLucas);
+  });
+
+  it("diretor (isCloserDiretor) fica fora do ranking e da herdada, mesmo com o maior recebido", () => {
+    expect(r.ranking.map((l) => l.closer_id)).not.toContain(DIR);
+    expect(r.herdada.map((l) => l.closer_id)).not.toContain(DIR);
+    expect(r.foraDoRanking.direcao).toMatchObject({ ativos: 1, mrr: 1000, recebido: 5000, quantidadeRecebida: 1 });
+  });
+
+  it("ranking por recebido desc, trim no nome do closer do cliente", () => {
+    expect(r.ranking.map((l) => l.nome)).toEqual(["Mariana", "Rogério"]);
+    expect(r.ranking[0]).toMatchObject({ ativos: 1, mrr: 500, recebido: 1200.15, quantidadeRecebida: 2, saidas: 1, mrrPerdido: 400 });
+    // "Rogério " (com espaço) casa com o closer; o pagamento pendente não conta
+    expect(r.ranking[1]).toMatchObject({ ativos: 1, mrr: 300, recebido: 0, quantidadeRecebida: 0 });
+  });
+
+  it("empate de recebido desempata por nome", () => {
+    const b = base();
+    b.pagamentos = [];
+    expect(calcularPorCloser(b, semComissao).ranking.map((l) => l.nome)).toEqual(["Mariana", "Rogério"]);
+    b.closers[1].nome = "Zeca";
+    b.clientes[1].closer = "Zeca";
+    expect(calcularPorCloser(b, semComissao).ranking.map((l) => l.nome)).toEqual(["Rogério", "Zeca"]);
+  });
+
+  it("closer inativo vai para herdada, sem comissão", () => {
+    expect(r.herdada).toHaveLength(1);
+    expect(r.herdada[0]).toMatchObject({ closer_id: LARI, nome: "Larissa", ativos: 1, mrr: 200, recebido: 700, saidas: 1, mrrPerdido: 150, comissao: null });
+    expect(r.ranking.map((l) => l.closer_id)).not.toContain(LARI);
+  });
+
+  it('"-" e nome desconhecido caem em semCloser; MRR só de status ativo', () => {
+    expect(r.foraDoRanking.semCloser).toMatchObject({ ativos: 2, mrr: 150, recebido: 160.55, quantidadeRecebida: 3 });
+  });
+
+  it("soma das partes bate com o total do mês", () => {
+    const partes = [...r.ranking, ...r.herdada, r.foraDoRanking.direcao, r.foraDoRanking.semCloser];
+    const soma = (f: (x: { recebido: number; quantidadeRecebida: number }) => number) => Math.round(partes.reduce((s, p) => s + f(p) * 100, 0)) / 100;
+    expect(r.totais.recebido).toBe(7060.7);
+    expect(r.totais.quantidadeRecebida).toBe(7);
+    expect(soma((p) => p.recebido)).toBe(r.totais.recebido);
+    expect(soma((p) => p.quantidadeRecebida)).toBe(r.totais.quantidadeRecebida);
+  });
+
+  it("churn sem cliente_receita_id fica separado e entra nos totais", () => {
+    expect(r.totais).toMatchObject({ saidas: 3, mrrPerdido: 800, churnSemVinculo: { saidas: 1, mrrPerdido: 250 } });
+    const porLinha = [...r.ranking, ...r.herdada, r.foraDoRanking.direcao, r.foraDoRanking.semCloser];
+    expect(porLinha.reduce((s, p) => s + p.saidas, 0) + r.totais.churnSemVinculo.saidas).toBe(r.totais.saidas);
+  });
+});
+
+describe("calcularPorCloser: comissão", () => {
+  it("mês aberto: casa por colaborador.id === closer_id; só funcao closer; sem par = null", () => {
+    const c = ok(resultado([
+      colab({ id: MARI, employee_id: "emp-mari", funcao: "closer", comissao_total: 123.45 }),
+      colab({ id: ROG, employee_id: "emp-rog", funcao: "sdr", comissao_total: 999 }),
+    ]));
+    const r = calcularPorCloser(base(), c);
+    expect(r.comissao).toEqual({ ok: true });
+    expect(r.ranking.find((l) => l.closer_id === MARI)?.comissao).toBe(123.45);
+    expect(r.ranking.find((l) => l.closer_id === ROG)?.comissao).toBeNull();
+  });
+
+  it("mês fechado: casa por employee_id via employees.entity_id", () => {
+    const c = ok(resultado([
+      colab({ id: "emp-mari", employee_id: "emp-mari", funcao: "closer", comissao_total: 77.7 }),
+      colab({ id: "emp-rog", employee_id: "emp-rog", funcao: "closer", comissao_total: 0 }),
+    ], true));
+    const r = calcularPorCloser(base(), c);
+    expect(r.ranking.find((l) => l.closer_id === MARI)?.comissao).toBe(77.7);
+    // zero medido é zero; ausência é null
+    expect(r.ranking.find((l) => l.closer_id === ROG)?.comissao).toBe(0);
+  });
+
+  it("leitura com falha: null em todas as linhas e comissao.ok false", () => {
+    const r = calcularPorCloser(base(), semComissao);
+    expect(r.comissao).toEqual({ ok: false, falha: "comissão sem leitura: x" });
+    expect([...r.ranking, ...r.herdada].every((l) => l.comissao === null)).toBe(true);
+  });
+
+  it("lista de colaboradores vazia: null, nunca 0", () => {
+    const r = calcularPorCloser(base(), ok(resultado([])));
+    expect(r.comissao.ok).toBe(false);
+    expect([...r.ranking, ...r.herdada].every((l) => l.comissao === null)).toBe(true);
+  });
+});
+
+describe("lerBaseCloser", () => {
+  it("aplica filtro de mês e de revertido, e não escreve", async () => {
+    const t = tabelasDe(base());
+    t.pagamentos_mensais.push({ cliente_id: "c1", valor_pago: 9999, status: "pago", mes_referencia: "2026-09-01" });
+    t.churn_log.push(
+      { cliente_receita_id: "c1", data_saida: "2026-09-30", mensalidade: 1, revertido: false },
+      { cliente_receita_id: "c1", data_saida: "2026-10-31", mensalidade: 2, revertido: false },
+      { cliente_receita_id: "c1", data_saida: "2026-11-01", mensalidade: 3, revertido: false },
+      { cliente_receita_id: "c1", data_saida: "2026-10-15", mensalidade: 4, revertido: true },
+    );
+    const { db, reg } = bancoFalso(t);
+    const r = await lerBaseCloser(db, "2026-10");
+    expect(r.ok).toBe(true);
+    if (!r.ok) return;
+    expect(r.dados.pagamentos).toHaveLength(8);
+    expect(r.dados.pagamentos.some((p) => p.valor_pago === 9999)).toBe(false);
+    expect(r.dados.churn).toHaveLength(4); // 3 da fixture + a de 31/10
+    expect(r.dados.churn.map((c) => c.mensalidade)).toContain(2);
+    expect(r.dados.churn.map((c) => c.mensalidade)).not.toContain(3);
+    expect(r.dados.churn.map((c) => c.mensalidade)).not.toContain(4);
+    expect(reg.filtros.pagamentos_mensais).toEqual([{ op: "eq", col: "mes_referencia", val: "2026-10-01" }]);
+    expect(reg.filtros.churn_log).toEqual(expect.arrayContaining([
+      { op: "eq", col: "revertido", val: false },
+      { op: "gte", col: "data_saida", val: "2026-10-01" },
+      { op: "lte", col: "data_saida", val: "2026-10-31" },
+    ]));
+    expect(reg.escritas).toBe(0);
+  });
+
+  it.each(["closers", "employees", "clientes_receita", "pagamentos_mensais", "churn_log"])("falha em %s = ok:false", async (tabela) => {
+    const { db } = bancoFalso(tabelasDe(base()), tabela);
+    const r = await lerBaseCloser(db, "2026-10");
+    expect(r.ok).toBe(false);
+    if (!r.ok) expect(r.falha).toContain("boom");
+  });
+});
+
+describe("GET /api/financeiro-v2/analise/closers", () => {
+  const chamar = (qs = "") => GET(new NextRequest(`http://x/api/financeiro-v2/analise/closers${qs}`));
+
+  beforeEach(() => {
+    h.db = bancoFalso(tabelasDe(base())).db;
+    h.comissao = async () => resultado([colab({ id: MARI, employee_id: "emp-mari", funcao: "closer", comissao_total: 50 })]);
+  });
+
+  it("200 com a visão e a comissão casada", async () => {
+    const res = await chamar("?mes=2026-10");
+    expect(res.status).toBe(200);
+    expect(res.headers.get("Cache-Control")).toBe("no-store");
+    const j = await res.json();
+    expect(j).toMatchObject({ ok: true, mes: "2026-10", comissao: { ok: true }, fonte: { lidoEm: "2026-10-29" } });
+    expect(j.ranking[0]).toMatchObject({ nome: "Mariana", comissao: 50 });
+  });
+
+  it("503 quando a leitura da base falha", async () => {
+    h.db = bancoFalso(tabelasDe(base()), "churn_log").db;
+    const res = await chamar("?mes=2026-10");
+    expect(res.status).toBe(503);
+    expect(await res.json()).toMatchObject({ ok: false, erro: expect.stringContaining("churn do mês") });
+  });
+
+  it("200 com comissao ok:false quando calcularComissao lança", async () => {
+    h.comissao = async () => { throw new Error("explodiu"); };
+    const res = await chamar("?mes=2026-10");
+    expect(res.status).toBe(200);
+    const j = await res.json();
+    expect(j.comissao).toMatchObject({ ok: false, falha: expect.stringContaining("explodiu") });
+    expect([...j.ranking, ...j.herdada].every((l: { comissao: number | null }) => l.comissao === null)).toBe(true);
+    expect(j.totais.recebido).toBe(7060.7);
+  });
+
+  it("400 para mês inválido", async () => {
+    expect((await chamar("?mes=2026-13")).status).toBe(400);
+  });
+});
diff --git a/src/lib/financeiro/v2/por-closer.ts b/src/lib/financeiro/v2/por-closer.ts
