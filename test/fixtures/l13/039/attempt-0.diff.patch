+import { beforeEach, describe, expect, it, vi } from "vitest";
+import { NextRequest } from "next/server";
+import type { SupabaseClient } from "@supabase/supabase-js";
+import type { ComissaoColaborador, ComissaoResult } from "@/lib/comissao-canonica";
+import type { Leitura } from "../tipos";
+
+const h = vi.hoisted(() => ({
+  db: null as unknown,
+  comissao: null as unknown as () => Promise<unknown>,
+}));
+
+// closers-diretores dispara loadPessoas() no import; o fallback literal (Lucas) basta aqui.
+vi.mock("@/lib/pessoa-canonica", () => ({ loadPessoas: async () => [] }));
+
+vi.mock("@/lib/financeiro/v2/servidor", async () => {
