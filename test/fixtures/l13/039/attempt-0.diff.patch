index 00000000..7322a4c8
--- /dev/null
+++ b/src/lib/financeiro/v2/por-closer.ts
@@ -0,0 +1,239 @@
+/**
+ * Visão por closer do Financeiro v2: carteira (ativos e MRR), recebido do mês, saídas (churn) e
+ * comissão do mês, por dono do cliente. SOMENTE LEITURA: só `select`.
+ *
+ * Dono do cliente: o closer cujo `closers.nome` (trim) é igual a `clientes_receita.closer` (trim).
+ * Sem par ("-", vazio ou nome desconhecido) = sem closer. Diretor sai pelo id canônico
+ * (`isCloserDiretor`), nunca por nome. Closer inativo (ex-closer) fica em carteira herdada, sem posição.
+ * A comissão vem inteira da comissao-canonica; aqui só se casa por id, sem recalcular faixa.
+ */
+import type { SupabaseClient } from "@supabase/supabase-js";
+import type { ComissaoResult } from "@/lib/comissao-canonica";
+import { isCloserDiretor } from "@/lib/closers-diretores";
+import { primeiroDia, ultimoDia } from "./datas";
+import { lerTudo, type PagamentoRow } from "./fontes";
+import { recebeu } from "./recebido";
+import { centavos, reaisDe, type Leitura } from "./tipos";
+
+// ─── Leitura ────────────────────────────────────────────────────────────────
+
+export interface CloserRow { id: string; nome: string; ativo: boolean | null }
+export interface EmployeeRow { id: string; entity_id: string | null }
+export interface ClienteCloserRow {
+  id: string;
+  nome: string;
+  closer: string | null;
+  status_financeiro: string | null;
+  valor_mensal: number;
+  categoria: string | null;
+}
+export interface PagamentoCloserRow { cliente_id: string; valor_pago: number | null; status: string }
+export interface ChurnCloserRow { cliente_receita_id: string | null; data_saida: string; mensalidade: number | null }
+
+export interface BaseCloser {
+  closers: CloserRow[];
+  employees: EmployeeRow[];
+  clientes: ClienteCloserRow[];
+  pagamentos: PagamentoCloserRow[];
+  churn: ChurnCloserRow[];
+}
+
+const num = (v: unknown): number => Number(v ?? 0);
+const textoOuNull = (v: unknown): string | null => (v === null || v === undefined ? null : String(v));
+
+export async function lerBaseCloser(db: SupabaseClient, mes: string): Promise<Leitura<BaseCloser>> {
+  const [cl, em, cr, pg, ch] = await Promise.all([
+    lerTudo<Record<string, unknown>>("closers", (de, a) =>
+      db.from("closers").select("id, nome, ativo").order("id").range(de, a)),
+    lerTudo<Record<string, unknown>>("employees", (de, a) =>
+      db.from("employees").select("id, entity_id").order("id").range(de, a)),
+    lerTudo<Record<string, unknown>>("clientes", (de, a) =>
+      db.from("clientes_receita").select("id, nome, closer, status_financeiro, valor_mensal, categoria").order("id").range(de, a)),
+    lerTudo<Record<string, unknown>>("pagamentos do mês", (de, a) =>
+      db.from("pagamentos_mensais").select("id, cliente_id, valor_pago, status")
+        .eq("mes_referencia", primeiroDia(mes)).order("id").range(de, a)),
+    lerTudo<Record<string, unknown>>("churn do mês", (de, a) =>
+      db.from("churn_log").select("id, cliente_receita_id, data_saida, mensalidade")
+        .eq("revertido", false).gte("data_saida", primeiroDia(mes)).lte("data_saida", ultimoDia(mes))
+        .order("id").range(de, a)),
+  ]);
+  if (!cl.ok) return cl;
+  if (!em.ok) return em;
+  if (!cr.ok) return cr;
+  if (!pg.ok) return pg;
+  if (!ch.ok) return ch;
+  return {
+    ok: true,
+    dados: {
+      closers: cl.dados.map((x) => ({ id: String(x.id), nome: String(x.nome ?? ""), ativo: (x.ativo as boolean | null) ?? null })),
+      employees: em.dados.map((x) => ({ id: String(x.id), entity_id: textoOuNull(x.entity_id) })),
+      clientes: cr.dados.map((x) => ({
+        id: String(x.id), nome: String(x.nome ?? ""), closer: textoOuNull(x.closer),
+        status_financeiro: textoOuNull(x.status_financeiro), valor_mensal: num(x.valor_mensal), categoria: textoOuNull(x.categoria),
+      })),
+      pagamentos: pg.dados.map((x) => ({
+        cliente_id: String(x.cliente_id), valor_pago: x.valor_pago === null || x.valor_pago === undefined ? null : num(x.valor_pago),
+        status: String(x.status ?? ""),
+      })),
+      churn: ch.dados.map((x) => ({
+        cliente_receita_id: textoOuNull(x.cliente_receita_id), data_saida: String(x.data_saida),
+        mensalidade: x.mensalidade === null || x.mensalidade === undefined ? null : num(x.mensalidade),
+      })),
+    },
+  };
+}
+
+// ─── Cálculo ────────────────────────────────────────────────────────────────
+
+export interface Resumo {
+  ativos: number;
+  mrr: number;
+  recebido: number;
+  quantidadeRecebida: number;
+  saidas: number;
+  mrrPerdido: number;
+}
+
+export interface LinhaCloser extends Resumo {
+  closer_id: string;
+  nome: string;
+  /** null = sem leitura da comissão ou closer sem par na lista. Nunca 0 inventado. */
+  comissao: number | null;
+}
+
+export interface PorCloser {
+  ranking: LinhaCloser[];
+  herdada: LinhaCloser[];
+  foraDoRanking: { direcao: Resumo; semCloser: Resumo };
+  totais: {
+    recebido: number;
+    quantidadeRecebida: number;
+    saidas: number;
+    mrrPerdido: number;
+    churnSemVinculo: { saidas: number; mrrPerdido: number };
+  };
+  comissao: { ok: true } | { ok: false; falha: string };
+}
+
+/** Acumulador em centavos. */
+interface Acum { ativos: number; mrr: number; recebido: number; quantidadeRecebida: number; saidas: number; mrrPerdido: number }
+const zero = (): Acum => ({ ativos: 0, mrr: 0, recebido: 0, quantidadeRecebida: 0, saidas: 0, mrrPerdido: 0 });
+const resumo = (a: Acum): Resumo => ({
+  ativos: a.ativos, mrr: reaisDe(a.mrr), recebido: reaisDe(a.recebido), quantidadeRecebida: a.quantidadeRecebida,
+  saidas: a.saidas, mrrPerdido: reaisDe(a.mrrPerdido),
+});
+
+type Balde = { tipo: "closer"; closer: CloserRow } | { tipo: "direcao" } | { tipo: "semCloser" };
+
+export function calcularPorCloser(base: BaseCloser, comissao: Leitura<ComissaoResult>): PorCloser {
+  const porNome = new Map<string, CloserRow>();
+  for (const c of base.closers) {
+    const k = c.nome.trim();
+    if (k && !porNome.has(k)) porNome.set(k, c);
+  }
+  const clientes = new Map(base.clientes.map((c) => [c.id, c]));
+
+  const acum = new Map<string, Acum>(); // por closer_id
+  const direcao = zero();
+  const semCloser = zero();
+
+  const baldeDe = (cliente: ClienteCloserRow | undefined): Balde => {
+    const nome = cliente?.closer?.trim() ?? "";
+    const closer = nome ? porNome.get(nome) : undefined;
+    if (!closer) return { tipo: "semCloser" };
+    if (isCloserDiretor(closer.id)) return { tipo: "direcao" };
+    return { tipo: "closer", closer };
+  };
+  const acumuladorDe = (b: Balde): Acum => {
+    if (b.tipo === "direcao") return direcao;
+    if (b.tipo === "semCloser") return semCloser;
+    let a = acum.get(b.closer.id);
+    if (!a) { a = zero(); acum.set(b.closer.id, a); }
+    return a;
+  };
+
+  for (const c of base.clientes) {
+    if (c.status_financeiro !== "ativo") continue;
+    const a = acumuladorDe(baldeDe(c));
+    a.ativos += 1;
+    a.mrr += centavos(c.valor_mensal);
+  }
+
+  const totais = { recebido: 0, quantidadeRecebida: 0, saidas: 0, mrrPerdido: 0 };
+  const semVinculo = { saidas: 0, mrrPerdido: 0 };
+
+  for (const p of base.pagamentos) {
+    if (!recebeu({ status: p.status } as PagamentoRow)) continue;
+    const v = centavos(p.valor_pago);
+    const a = acumuladorDe(baldeDe(clientes.get(p.cliente_id)));
+    a.recebido += v;
+    a.quantidadeRecebida += 1;
+    totais.recebido += v;
+    totais.quantidadeRecebida += 1;
+  }
+
+  for (const r of base.churn) {
+    const v = centavos(r.mensalidade);
+    totais.saidas += 1;
+    totais.mrrPerdido += v;
+    if (!r.cliente_receita_id) {
+      semVinculo.saidas += 1;
+      semVinculo.mrrPerdido += v;
+      continue;
+    }
+    const a = acumuladorDe(baldeDe(clientes.get(r.cliente_receita_id)));
+    a.saidas += 1;
+    a.mrrPerdido += v;
+  }
+
+  // Comissão: só da comissao-canonica, só colaborador closer, casada por id.
+  let falhaComissao: string | null = null;
+  const comissaoPorCloser = new Map<string, number>();
+  if (!comissao.ok) {
+    falhaComissao = comissao.falha;
+  } else if (!comissao.dados.colaboradores || comissao.dados.colaboradores.length === 0) {
+    falhaComissao = "comissão sem leitura: nenhum colaborador devolvido";
+  } else {
+    const entityDoEmployee = new Map(base.employees.map((e) => [e.id, e.entity_id]));
+    for (const col of comissao.dados.colaboradores) {
+      if (col.funcao !== "closer") continue;
+      const valor = reaisDe(centavos(col.comissao_total));
+      for (const c of base.closers) {
+        const casa = col.id === c.id || (!!col.employee_id && entityDoEmployee.get(col.employee_id) === c.id);
+        if (casa && !comissaoPorCloser.has(c.id)) comissaoPorCloser.set(c.id, valor);
+      }
+    }
+  }
+
+  const linha = (c: CloserRow): LinhaCloser => ({
+    closer_id: c.id,
+    nome: c.nome.trim(),
+    ...resumo(acum.get(c.id) ?? zero()),
+    comissao: falhaComissao !== null ? null : (comissaoPorCloser.get(c.id) ?? null),
+  });
+
+  const ranking: LinhaCloser[] = [];
+  const herdada: LinhaCloser[] = [];
+  for (const c of base.closers) {
+    if (isCloserDiretor(c.id)) continue;
+    if (c.ativo === false) herdada.push({ ...linha(c), comissao: null });
+    else ranking.push(linha(c));
+  }
+  const porNomeAsc = (a: LinhaCloser, b: LinhaCloser) => a.nome.localeCompare(b.nome, "pt-BR");
+  ranking.sort((a, b) => b.recebido - a.recebido || porNomeAsc(a, b));
+  herdada.sort(porNomeAsc);
+
+  return {
+    ranking,
+    herdada,
+    foraDoRanking: { direcao: resumo(direcao), semCloser: resumo(semCloser) },
+    totais: {
+      recebido: reaisDe(totais.recebido),
+      quantidadeRecebida: totais.quantidadeRecebida,
+      saidas: totais.saidas,
+      mrrPerdido: reaisDe(totais.mrrPerdido),
+      churnSemVinculo: { saidas: semVinculo.saidas, mrrPerdido: reaisDe(semVinculo.mrrPerdido) },
+    },
+    comissao: falhaComissao === null ? { ok: true } : { ok: false, falha: falhaComissao },
+  };
+}
