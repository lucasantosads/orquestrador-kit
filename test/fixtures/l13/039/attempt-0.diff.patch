+vi.mock("@/lib/comissao-canonica", () => ({ calcularComissao: () => h.comissao() }));
+
+import { GET } from "@/app/api/financeiro-v2/analise/closers/route";
+import { calcularPorCloser, lerBaseCloser, type BaseCloser } from "../por-closer";
+
+// ─── Fixture ────────────────────────────────────────────────────────────────
+
+const DIR = "a987d655-88d0-490b-ad73-efe04843a2ec"; // Lucas, no fallback de closers-diretores
+const MARI = "closer-mariana";
+const ROG = "closer-rogerio";
+const LARI = "closer-larissa";
+
+const cli = (id: string, closer: string | null, valor: number, status = "ativo") =>
+  ({ id, nome: `Cliente ${id}`, closer, status_financeiro: status, valor_mensal: valor, categoria: null });
+
+function base(): BaseCloser {
+  return {
+    closers: [
+      { id: DIR, nome: "Lucas", ativo: true },
+      { id: MARI, nome: "Mariana", ativo: true },
+      { id: ROG, nome: "Rogério", ativo: true },
+      { id: LARI, nome: "Larissa", ativo: false },
+    ],
+    employees: [
+      { id: "emp-dir", entity_id: DIR }, { id: "emp-mari", entity_id: MARI },
+      { id: "emp-rog", entity_id: ROG }, { id: "emp-lari", entity_id: LARI },
+    ],
+    clientes: [
+      cli("c1", "Lucas", 1000), cli("c2", "Mariana", 500), cli("c3", "Rogério ", 300),
+      cli("c4", "Larissa", 200), cli("c5", "-", 100), cli("c6", "Fulano", 50),
+      cli("c7", "Mariana", 400, "churned"),
+    ],
+    pagamentos: [
+      { cliente_id: "c1", valor_pago: 5000, status: "pago" },
+      { cliente_id: "c2", valor_pago: 1000.1, status: "pago" },
+      { cliente_id: "c2", valor_pago: 200.05, status: "parcial" },
+      { cliente_id: "c3", valor_pago: 300, status: "pendente" },
+      { cliente_id: "c4", valor_pago: 700, status: "pago" },
+      { cliente_id: "c5", valor_pago: 100, status: "pago" },
+      { cliente_id: "c6", valor_pago: 50.55, status: "parcial" },
+      { cliente_id: "fantasma", valor_pago: 10, status: "pago" },
+    ],
+    churn: [
+      { cliente_receita_id: "c7", data_saida: "2026-10-10", mensalidade: 400 },
+      { cliente_receita_id: null, data_saida: "2026-10-12", mensalidade: 250 },
+      { cliente_receita_id: "c4", data_saida: "2026-10-20", mensalidade: 150 },
