+/**
+ * GET /api/financeiro-v2/analise/retencao[?mes=YYYY-MM]
+ * Retenção por coorte de entrada e churn dos 12 meses até `mes`.
+ * SOMENTE LEITURA: nenhuma escrita. Falha de leitura = 503, nunca 200 vazio.
+ */
+import { NextRequest, NextResponse } from "next/server";
+import { calcularRetencao, lerBaseCoorte, REGRA_RETENCAO } from "@/lib/financeiro/v2/coorte";
+import { autorizar, mesPedido } from "@/lib/financeiro/v2/servidor";
+
+export const dynamic = "force-dynamic";
+export const maxDuration = 60;
+
+export async function GET(req: NextRequest) {
+  const a = await autorizar();
+  if (!a.ok) return NextResponse.json({ ok: false, erro: a.erro }, { status: a.status });
+  const mes = mesPedido(req.nextUrl.searchParams.get("mes"), a.hoje);
+  if (!mes) return NextResponse.json({ ok: false, erro: "Mês inválido." }, { status: 400 });
+
+  const r = await lerBaseCoorte(a.db);
+  if (!r.ok) return NextResponse.json({ ok: false, erro: r.falha }, { status: 503, headers: { "Cache-Control": "no-store" } });
+
+  return NextResponse.json(
+    {
+      ok: true,
+      mes,
+      ...calcularRetencao(r.dados, mes, 12),
+      fonte: { regra: REGRA_RETENCAO, tabelas: ["clientes_receita", "churn_log"], lidoEm: a.hoje.iso },
+    },
+    { headers: { "Cache-Control": "no-store" } },
+  );
+}
