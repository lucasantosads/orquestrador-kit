diff --git a/apps/web/test/aprovar-publico.test.tsx b/apps/web/test/aprovar-publico.test.tsx
new file mode 100644
index 0000000..7648a29
--- /dev/null
+++ b/apps/web/test/aprovar-publico.test.tsx
@@ -0,0 +1,139 @@
+// Ticket 243 — a rota pública do link de aprovação, provada em dois níveis:
+// (a) pela função pura isPublicPath; (b) por um request SEM SESSÃO atravessando updateSession.
+// Mocka '@supabase/ssr' (padrão de briefing-gate.test.ts) e usa NextRequest real.
+
+import { describe, it, expect, beforeEach, vi } from 'vitest'
+import { NextRequest } from 'next/server'
+import { renderToStaticMarkup } from 'react-dom/server'
+
+let mockUser: { id: string } | null = null
+const tabelasConsultadas: string[] = []
+
+vi.mock('@supabase/ssr', () => ({
+  createServerClient: () => ({
+    auth: {
+      getUser: async () => ({ data: { user: mockUser } }),
+    },
+    from: (table: string) => {
+      tabelasConsultadas.push(table)
+      throw new Error(`consulta inesperada: ${table}`)
+    },
+  }),
+}))
+
+vi.mock('server-only', () => ({}))
+
+const notFoundMock = vi.fn(() => {
+  throw new Error('NEXT_NOT_FOUND')
+})
+vi.mock('next/navigation', () => ({ notFound: () => notFoundMock() }))
+vi.mock('next/cache', () => ({ revalidatePath: vi.fn() }))
+
+const lerMock = vi.fn()
+const decidirMock = vi.fn()
+vi.mock('@/server/aprovacoes-publico', () => ({
+  lerRoteiroPorToken: (...a: unknown[]) => lerMock(...a),
+  decidirPorToken: (...a: unknown[]) => decidirMock(...a),
+}))
+
+const { updateSession } = await import('../src/lib/supabase/middleware')
+const { isPublicPath, isAuthScreen } = await import('../src/lib/auth/routes')
+const { default: AprovarPage } = await import('../src/app/aprovar/[token]/page')
+
+const TOKEN = 'tok-secreto-9f8e7d6c'
+
+function req(pathname: string) {
+  return new NextRequest(new URL(pathname, 'https://app.example.com'))
+}
+
+async function renderizar(): Promise<string> {
+  return renderToStaticMarkup(await AprovarPage({ params: Promise.resolve({ token: TOKEN }) }))
+}
+
+const roteiro = {
+  gancho: 'GANCHO-DO-ROTEIRO',
+  corpo: 'CORPO-DO-ROTEIRO',
+  legenda: 'LEGENDA-DO-ROTEIRO',
+  hashtags: ['#direito', '#advocacia'],
+  veredito: 'VEREDITO-APROVADO',
+  estado: 'pendente' as const,
+  comentario: null,
+}
+
+beforeEach(() => {
+  mockUser = null
+  tabelasConsultadas.length = 0
+  lerMock.mockReset()
+  decidirMock.mockReset()
+  notFoundMock.mockClear()
+})
+
+describe('ticket 243 — classe pública, nos dois níveis', () => {
+  it('função pura: /aprovar e /aprovar/<token> são públicos, /aprovacoes não, e não é tela de auth', () => {
+    expect(isPublicPath('/aprovar')).toBe(true)
+    expect(isPublicPath(`/aprovar/${TOKEN}`)).toBe(true)
+    expect(isPublicPath('/aprovacoes')).toBe(false)
+    expect(isAuthScreen(`/aprovar/${TOKEN}`)).toBe(false)
+  })
+
+  it('sem sessão, /aprovar/<token> atravessa o middleware sem ir para /login', async () => {
+    const res = await updateSession(req(`/aprovar/${TOKEN}`))
+    expect(res.headers.get('location')).toBeNull()
+  })
+
+  it('sem sessão, /aprovacoes (fila interna) redireciona para /login', async () => {
+    const res = await updateSession(req('/aprovacoes'))
+    expect(res.headers.get('location')).toContain('/login')
+  })
+
+  it('sem sessão, /aprovar não dispara consulta de organization_members nem de personas', async () => {
+    await updateSession(req(`/aprovar/${TOKEN}`))
+    await updateSession(req('/aprovar'))
+    expect(tabelasConsultadas).toEqual([])
+  })
+
+  it('com sessão, /aprovar/<token> não é mandado para a home', async () => {
+    mockUser = { id: 'user-1' }
+    const res = await updateSession(req(`/aprovar/${TOKEN}`))
+    expect(res.headers.get('location')).toBeNull()
+  })
+})
+
+describe('ticket 243 — a página do link', () => {
+  it('com roteiro válido mostra gancho, corpo, legenda, hashtags e veredito', async () => {
+    lerMock.mockResolvedValue(roteiro)
+    const html = await renderizar()
+    expect(lerMock).toHaveBeenCalledWith(TOKEN)
+    expect(html).toContain('GANCHO-DO-ROTEIRO')
+    expect(html).toContain('CORPO-DO-ROTEIRO')
+    expect(html).toContain('LEGENDA-DO-ROTEIRO')
+    expect(html).toContain('#direito #advocacia')
+    expect(html).toContain('VEREDITO-APROVADO')
+    expect(html).toContain('Aprovar')
+    expect(html).toContain('Pedir ajuste')
+  })
+
+  it('com leitura nula (inválido, expirado ou revogado) chama notFound', async () => {
+    lerMock.mockResolvedValue(null)
+    await expect(renderizar()).rejects.toThrow('NEXT_NOT_FOUND')
+    expect(notFoundMock).toHaveBeenCalledTimes(1)
+  })
+
+  it('não mostra persona, ângulo, score, link para outra tela nem o token', async () => {
+    lerMock.mockResolvedValue(roteiro)
+    const html = await renderizar()
+    expect(html).not.toMatch(/persona|ângulo|angulo|score|nota/i)
+    expect(html).not.toMatch(/<a[\s>]/i)
+    expect(html).not.toMatch(/href=/i)
+    expect(html).not.toContain(TOKEN)
+  })
+
+  it('link já respondido mostra estado e comentário, sem oferecer os botões', async () => {
+    lerMock.mockResolvedValue({ ...roteiro, estado: 'ajuste_pedido', comentario: 'TROCAR-O-GANCHO' })
+    const html = await renderizar()
+    expect(html).toContain('Ajuste pedido.')
+    expect(html).toContain('TROCAR-O-GANCHO')
+    expect(html).not.toMatch(/<button/i)
+    expect(html).not.toMatch(/<textarea/i)
+  })
+})
