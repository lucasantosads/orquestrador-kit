+// Ticket 243 — a tela que o cliente do escritório abre pelo link. Mostra UM roteiro: gancho e corpo,
+// legenda com hashtags e o resultado da checagem do Provimento 205. Nada além disso.
+//
+// Link inexistente, vencido e cancelado caem no MESMO notFound(), sem texto que diga qual foi.
+// O token vive na URL e na ação (fechado no servidor): não entra em texto, atributo nem registro.
+
+import { notFound } from 'next/navigation'
+import { revalidatePath } from 'next/cache'
+import { decidirPorToken, lerRoteiroPorToken } from '@/server/aprovacoes-publico'
+
+export const dynamic = 'force-dynamic'
+
+export default async function AprovarPage({ params }: { params: Promise<{ token: string }> }) {
+  const { token } = await params
+  const roteiro = await lerRoteiroPorToken(token)
+  if (!roteiro) notFound()
+
+  async function aprovar() {
+    'use server'
+    await decidirPorToken(token, 'aprovado')
+    revalidatePath(`/aprovar/${token}`)
+  }
+
+  async function pedirAjuste(formData: FormData) {
+    'use server'
+    const comentario = String(formData.get('comentario') ?? '').trim()
+    if (comentario === '') return
+    await decidirPorToken(token, 'ajuste_pedido', comentario)
+    revalidatePath(`/aprovar/${token}`)
+  }
+
+  const respondido = roteiro.estado !== 'pendente'
+
+  return (
+    <main style={{ maxWidth: 720, margin: '0 auto', padding: '32px 16px' }}>
+      <section aria-labelledby="roteiro-titulo">
+        <h1 id="roteiro-titulo">Roteiro</h1>
+        <h2>Gancho</h2>
+        <p style={{ whiteSpace: 'pre-wrap' }}>{roteiro.gancho}</p>
+        <h2>Corpo</h2>
+        <p style={{ whiteSpace: 'pre-wrap' }}>{roteiro.corpo}</p>
+      </section>
+
+      <section aria-labelledby="legenda-titulo">
+        <h2 id="legenda-titulo">Legenda</h2>
+        <p style={{ whiteSpace: 'pre-wrap' }}>{roteiro.legenda}</p>
+        {roteiro.hashtags.length > 0 && <p>{roteiro.hashtags.join(' ')}</p>}
+      </section>
+
+      <section aria-labelledby="checagem-titulo">
+        <h2 id="checagem-titulo">Checagem do Provimento 205</h2>
+        <p>{roteiro.veredito}</p>
+      </section>
+
+      {respondido ? (
+        <section aria-labelledby="resposta-titulo">
+          <h2 id="resposta-titulo">Sua resposta</h2>
+          <p>{roteiro.estado === 'aprovado' ? 'Roteiro aprovado.' : 'Ajuste pedido.'}</p>
+          {roteiro.comentario && <p style={{ whiteSpace: 'pre-wrap' }}>{roteiro.comentario}</p>}
+        </section>
+      ) : (
+        <section aria-labelledby="decisao-titulo">
+          <h2 id="decisao-titulo">Sua resposta</h2>
+          <form action={aprovar}>
+            <button type="submit">Aprovar</button>
+          </form>
+          <form action={pedirAjuste}>
+            <label htmlFor="comentario">O que precisa ser ajustado</label>
+            <textarea id="comentario" name="comentario" required rows={4} style={{ display: 'block', width: '100%' }} />
+            <button type="submit">Pedir ajuste</button>
+          </form>
+        </section>
+      )}
+    </main>
+  )
+}
