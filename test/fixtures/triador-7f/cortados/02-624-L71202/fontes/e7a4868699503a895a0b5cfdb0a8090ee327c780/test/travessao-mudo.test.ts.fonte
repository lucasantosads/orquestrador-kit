import { describe, it, expect } from "vitest";
import * as fs from "node:fs";
import * as path from "node:path";

// medido em 2026-10-01 apos o 627i (visao-geral-churn zerada, sobram os 4 de src/components/analytics) com o contador deste arquivo. Cada ticket de area (627a-627k) baixa este numero no mesmo diff.
const TETO = 4;

const RAIZ = path.resolve(__dirname, "..");
const SRC = path.join(RAIZ, "src");
const EXCECAO = path.join(SRC, "components", "estados", "sem-dado.tsx");

/** Remove comentarios preservando quebras de linha e ignorando o que esta dentro de string. */
export function removerComentarios(src: string): string {
  let out = "";
  let i = 0;
  let aspa: string | null = null;
  while (i < src.length) {
    const c = src[i];
    const n = src[i + 1];
    if (aspa) {
      out += c;
      if (c === "\\" && n !== undefined) {
        out += n;
        i += 2;
        continue;
      }
      // aspas simples/duplas nao atravessam linha (apostrofo em texto JSX nao pode engolir o resto)
      if (c === aspa || (c === "\n" && aspa !== "`")) aspa = null;
      i++;
      continue;
    }
    if (c === "/" && n === "*") {
      const fim = src.indexOf("*/", i + 2);
      const fimIdx = fim === -1 ? src.length : fim + 2;
      out += src.slice(i, fimIdx).replace(/[^\n]/g, "");
      i = fimIdx;
      continue;
    }
    if (c === "/" && n === "/" && src[i - 1] !== ":") {
      while (i < src.length && src[i] !== "\n") i++;
      continue;
    }
    if (c === '"' || c === "'" || c === "`") aspa = c;
    out += c;
    i++;
  }
  return out;
}

const RE_LITERAL = /(["'`])[—–]\1/g;
const RE_JSX = />[ \t]*[—–][ \t]*</g;

function contarLinha(linha: string): number {
  return (linha.match(RE_LITERAL)?.length ?? 0) + (linha.match(RE_JSX)?.length ?? 0);
}

export function contarTravessaoMudo(src: string): number {
  return removerComentarios(src)
    .split("\n")
    .reduce((acc, l) => acc + contarLinha(l), 0);
}

function listarTsx(dir: string): string[] {
  const res: string[] = [];
  for (const e of fs.readdirSync(dir, { withFileTypes: true })) {
    const p = path.join(dir, e.name);
    if (e.isDirectory()) res.push(...listarTsx(p));
    else if (e.isFile() && p.endsWith(".tsx") && p !== EXCECAO) res.push(p);
  }
  return res;
}

function medir() {
  let total = 0;
  const porArquivo: Record<string, number> = {};
  const locais: string[] = [];
  for (const arq of listarTsx(SRC).sort()) {
    const linhas = removerComentarios(fs.readFileSync(arq, "utf8")).split("\n");
    const rel = path.relative(RAIZ, arq).split(path.sep).join("/");
    linhas.forEach((l, idx) => {
      const n = contarLinha(l);
      if (n > 0) {
        total += n;
        porArquivo[rel] = (porArquivo[rel] ?? 0) + n;
        locais.push(`${rel}:${idx + 1}`);
      }
    });
  }
  return { total, porArquivo, locais };
}

describe("travessao mudo em tela", () => {
  it("travessao mudo nao passa do teto", () => {
    const { total, porArquivo, locais } = medir();
    const destino = process.env.TRAVESSAO_RELATORIO;
    if (destino) {
      fs.writeFileSync(destino, JSON.stringify({ total, teto: TETO, porArquivo }));
    }
    expect(
      total,
      `travessao mudo: ${total} > teto ${TETO}. Ocorrencias:\n${locais.join("\n")}`,
    ).toBeLessThanOrEqual(TETO);
  });

  it("sem-dado.tsx continua sendo a excecao e tem o travessao", () => {
    const fonte = fs.readFileSync(EXCECAO, "utf8");
    expect(fonte).toContain("—");
  });

  it("contador casa os casos de travessao mudo", () => {
    expect(contarTravessaoMudo('return "—";')).toBe(1);
    expect(contarTravessaoMudo('x ?? "—"')).toBe(1);
    expect(contarTravessaoMudo('a || "–"')).toBe(1);
    expect(contarTravessaoMudo('c ? d : "—"')).toBe(1);
    expect(contarTravessaoMudo("<td>—</td>")).toBe(1);
    expect(contarTravessaoMudo("<td> — </td>")).toBe(1);
    expect(contarTravessaoMudo('{"—"}')).toBe(1);
    expect(contarTravessaoMudo('placeholder="—"')).toBe(1);
  });

  it("contador ignora frase, comentario e separador", () => {
    expect(contarTravessaoMudo('{" — "}')).toBe(0);
    expect(contarTravessaoMudo('"nao vinculado ao pipeline — documentos"')).toBe(0);
    expect(contarTravessaoMudo('// return "—"')).toBe(0);
    expect(contarTravessaoMudo('/* "—" */')).toBe(0);
    expect(contarTravessaoMudo('{/* "—" */}')).toBe(0);
    expect(contarTravessaoMudo('href="https://x.com" // "—"')).toBe(0);
  });
});
