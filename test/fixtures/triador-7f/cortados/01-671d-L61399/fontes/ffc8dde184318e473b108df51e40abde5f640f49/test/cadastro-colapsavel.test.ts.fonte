/**
 * Ticket 292 — colapsar o cadastro do cartão de identidade atrás de
 * "Editar cadastro".
 *
 * RECON (mesma limitação documentada em test/header-cliente-consolidado.test.ts,
 * test/sessao-degradada.test.ts e test/tooltip-acessivel.test.ts): este projeto
 * tem `"jsx": "preserve"` no tsconfig.json e não tem jsdom/@testing-library
 * instalados, então um `import` direto de geral-tab.tsx quebra o parse do
 * vitest antes de qualquer teste rodar. A saída, igual à de
 * test/sessao-degradada.test.ts: ler o ARQUIVO REAL do disco, compilar o JSX
 * com esbuild (dependência já presente via vite) e executar o CommonJS
 * resultante num `Module` do Node — o código que roda abaixo é o
 * IdentidadeCliente de verdade, não uma cópia. Só as dependências externas
 * (useFicha, ícones, componentes de UI, toast) são trocadas por dublês.
 *
 * Por que não dá pra simular um clique de verdade com um DOM interativo: sem
 * jsdom só existe `react-dom/server` (renderToStaticMarkup), que é uma
 * renderização de passe único — não há fiber vivo depois que ela retorna, e
 * confirmei isso rodando um experimento à parte: chamar o `setState`
 * capturado depois do render não lança, mas também não executa a função de
 * atualização (o React descarta o update, não há reconciliação para
 * processá-lo). Por isso o clique é testado nas DUAS metades que compõem o
 * comportamento real, cada uma exercitando código de verdade:
 *
 *   1) o handler `onClick` do botão "Editar cadastro" é capturado ao vivo
 *      (o mock de <Button> grava a prop `onClick` recebida) e EXECUTADO. Ele
 *      roda de forma síncrona no corpo do handler (não dentro do updater do
 *      setState, que o React pode descartar) — então observamos o efeito
 *      colateral real: a chamada grava a preferência "aberto" no
 *      sessionStorage.
 *   2) um segundo render de verdade, com o sessionStorage já contendo essa
 *      preferência ("aberto"), prova que o cadastro nasce aberto quando a
 *      sessão diz que deveria — ou seja, o mesmo valor que o clique gravou é
 *      o que faz os campos aparecerem. Encadeado com (1), isso prova
 *      fechado -> clique -> aberto de ponta a ponta, sem reimplementar a
 *      lógica em paralelo.
 */
import { describe, it, expect, beforeEach } from "vitest";
import { readFileSync } from "node:fs";
import { resolve, dirname } from "node:path";
import { Module, createRequire } from "node:module";
import vm from "node:vm";
import { transformSync } from "esbuild";
import React from "react";

const GERAL_TAB_PATH = resolve(__dirname, "../src/app/dashboard/clientes/[id]/tabs/geral-tab.tsx");

// @types/react-dom não está instalado (mesma nota de sessao-degradada.test.ts).
const { renderToStaticMarkup } = createRequire(import.meta.url)("react-dom/server") as {
  renderToStaticMarkup: (element: React.ReactElement) => string;
};

type FichaMock = {
  id: string;
  cliente: Record<string, unknown>;
  update: (field: string, value: string) => Promise<void>;
  setCliente: (updater: unknown) => void;
  gestores: unknown[];
  extra: Record<string, unknown> | null;
  fechamento: Record<string, unknown> | null;
  perfClienteId: string | null;
  editingPlataforma: boolean;
  setEditingPlataforma: (v: boolean) => void;
  editingNicho: boolean;
  setEditingNicho: (v: boolean) => void;
  nichoOpts: string[];
  salvarExtra: (fields: Record<string, unknown>) => Promise<void>;
};

let fichaMock: FichaMock;
/** Handlers onClick reais, capturados ao vivo pelo dublê de <Button> por data-testid. */
let cliquesCapturados: Record<string, () => void>;

function iconeStub() {
  return function Icone() {
    return null;
  };
}

function loadIdentidadeCliente(): {
  IdentidadeCliente: React.ComponentType<{ score: unknown; risco: string | null; perfResolved: boolean }>;
  lerCadastroAbertoPersistido: (clienteId: string) => boolean;
  persistirCadastroAberto: (clienteId: string, aberto: boolean) => void;
} {
  const source = readFileSync(GERAL_TAB_PATH, "utf-8");
  const { code } = transformSync(source, {
    loader: "tsx",
    jsx: "automatic",
    format: "cjs",
    target: "node18",
    sourcefile: GERAL_TAB_PATH,
  });

  const iconesLucide = new Proxy(
    {},
    { get: () => iconeStub() },
  );

  const mocks: Record<string, unknown> = {
    react: React,
    sonner: { toast: { error: () => {}, success: () => {} } },
    "lucide-react": iconesLucide,
    "@/lib/format": { formatCurrency: (n: number) => `R$ ${n}` },
    // Ticket 295: geral-tab.tsx passou a importar fetchJson (helper único de
    // fetch+parse) — precisa de um dublê aqui pelo mesmo motivo dos outros
    // módulos: o customRequire acima só resolve o que está neste dicionário.
    "@/lib/fetch-json": {
      fetchJson: async () => { throw new Error("fetchJson não deveria ser chamado neste teste (sem render de efeitos)"); },
      FetchJsonError: class FetchJsonError extends Error {},
    },
    "@/components/ui/card": {
      Card: (props: React.HTMLAttributes<HTMLDivElement>) => React.createElement("div", props),
      CardContent: (props: React.HTMLAttributes<HTMLDivElement>) => React.createElement("div", props),
      CardHeader: (props: React.HTMLAttributes<HTMLDivElement>) => React.createElement("div", props),
      CardTitle: (props: React.HTMLAttributes<HTMLDivElement>) => React.createElement("div", props),
    },
    "@/components/ui/badge": {
      Badge: (props: React.HTMLAttributes<HTMLSpanElement>) => React.createElement("span", props),
    },
    "@/components/ui/button": {
      // Dublê que se comporta como um <button> nativo, mas grava o onClick
      // recebido por data-testid para o teste poder "clicar" de verdade
      // chamando a MESMA função que o componente passou pro botão real.
      Button: ({ ...props }: React.ButtonHTMLAttributes<HTMLButtonElement> & { "data-testid"?: string }) => {
        const testId = props["data-testid"];
        if (testId && typeof props.onClick === "function") {
          cliquesCapturados[testId] = props.onClick as () => void;
        }
        return React.createElement("button", props);
      },
    },
    "@/components/ui/input": {
      Input: (props: React.InputHTMLAttributes<HTMLInputElement>) => React.createElement("input", props),
    },
    "@/components/ui/label": {
      Label: (props: React.LabelHTMLAttributes<HTMLLabelElement>) => React.createElement("label", props),
    },
    "@/components/estados/sem-insumo": {
      corScoreSaude: () => "text-green-400",
      temValor: (estado: { valor?: number | null }) => estado != null && estado.valor != null,
      MOTIVO_NAO_AVALIADO: "ainda não avaliado",
    },
    "@/components/estados/sem-dado": {
      SemDado: ({ motivo }: { motivo: string }) => React.createElement("span", null, motivo),
    },
    // Ticket 302: geral-tab.tsx passou a importar BlocoVazioLinha (estado
    // vazio de uma linha) — mesmo motivo dos outros dublês deste dicionário:
    // o customRequire só resolve o que está aqui.
    "@/components/estados/bloco-vazio-linha": {
      BlocoVazioLinha: ({ rotulo, texto }: { rotulo: string; texto: string }) =>
        React.createElement("p", null, `${rotulo} — ${texto}`),
    },
    "../_components/cockpit-visao-geral": {
      CockpitVisaoGeral: () => React.createElement("div", { "data-testid": "cockpit-stub" }),
    },
    "./ficha-types": {
      STATUS_OPTS: ["Ativo", "Pausado", "Finalizado"],
      CHURN_BLOCKED_FROM: [],
      STATUS_COLORS: {},
      SITUACAO_COLORS: {},
      RESULTADOS_COLORS: {},
      ATENCAO_OPTS: ["Verde", "Amarelo", "Vermelho"],
      ATENCAO_COLORS: {},
      DIA_OPTS: ["Segunda"],
      PLATAFORMA_OPTS: ["Meta"],
      TESE_STATUS_COLORS: {},
      ENTREGAVEL_STATUS_COLORS: {},
    },
    "./ficha-context": { useFicha: () => fichaMock },
  };

  const mod = new Module(GERAL_TAB_PATH, module);
  mod.filename = GERAL_TAB_PATH;
  mod.paths = (Module as unknown as { _nodeModulePaths(dir: string): string[] })._nodeModulePaths(
    dirname(GERAL_TAB_PATH),
  );
  const wrapper = vm.runInThisContext(Module.wrap(code), { filename: GERAL_TAB_PATH });
  const customRequire = (id: string) => (id in mocks ? mocks[id] : mod.require(id));
  wrapper.call(mod.exports, mod.exports, customRequire, mod, GERAL_TAB_PATH, dirname(GERAL_TAB_PATH));

  return mod.exports as {
    IdentidadeCliente: React.ComponentType<{ score: unknown; risco: string | null; perfResolved: boolean }>;
    lerCadastroAbertoPersistido: (clienteId: string) => boolean;
    persistirCadastroAberto: (clienteId: string, aberto: boolean) => void;
  };
}

const { IdentidadeCliente, lerCadastroAbertoPersistido, persistirCadastroAberto } = loadIdentidadeCliente();

const SCORE_COM_VALOR = { valor: 78, motivo: null };

function novoFichaMock(overrides: Partial<FichaMock> = {}): FichaMock {
  return {
    id: "cliente-292",
    cliente: {
      nome: "Cliente Teste",
      status: "Ativo",
      analista: "Fulano Gestor",
      situacao: "Em dia",
      resultados: "Bom",
      atencao: "Verde",
      dia_otimizacao: "",
      ultimo_feedback: "",
      ultima_otimizacao: "",
      plataformas: "Meta",
      nicho: "E-commerce",
      orcamento: null,
    },
    update: async () => {},
    setCliente: () => {},
    gestores: [],
    extra: null,
    fechamento: null,
    perfClienteId: null,
    editingPlataforma: false,
    setEditingPlataforma: () => {},
    editingNicho: false,
    setEditingNicho: () => {},
    nichoOpts: [],
    salvarExtra: async () => {},
    ...overrides,
  };
}

/** sessionStorage real o bastante para os testes: get/set/remove em memória. */
function criarSessionStorageMock(inicial: Record<string, string> = {}): Storage {
  const dados = new Map(Object.entries(inicial));
  return {
    getItem: (k: string) => (dados.has(k) ? dados.get(k)! : null),
    setItem: (k: string, v: string) => { dados.set(k, v); },
    removeItem: (k: string) => { dados.delete(k); },
    clear: () => { dados.clear(); },
    key: () => null,
    get length() { return dados.size; },
  } as Storage;
}

beforeEach(() => {
  fichaMock = novoFichaMock();
  cliquesCapturados = {};
  // @ts-expect-error -- ambiente de teste Node não tem sessionStorage por padrão.
  delete globalThis.sessionStorage;
});

function render(): string {
  return renderToStaticMarkup(
    React.createElement(IdentidadeCliente, { score: SCORE_COM_VALOR, risco: "Baixo", perfResolved: true }),
  );
}

describe("funções puras de persistência (executadas de verdade, extraídas do módulo real)", () => {
  it("sem sessionStorage no ambiente, cai em fechado — não lança", () => {
    expect(() => lerCadastroAbertoPersistido("cliente-292")).not.toThrow();
    expect(lerCadastroAbertoPersistido("cliente-292")).toBe(false);
  });

  it("sem sessionStorage no ambiente, persistir não lança (try/catch cobre o write também)", () => {
    expect(() => persistirCadastroAberto("cliente-292", true)).not.toThrow();
  });

  it("com sessionStorage disponível, grava e lê a preferência de volta, isolada por cliente", () => {
    globalThis.sessionStorage = criarSessionStorageMock();
    persistirCadastroAberto("cliente-292", true);
    expect(lerCadastroAbertoPersistido("cliente-292")).toBe(true);
    // Outro cliente não herda a preferência — chave é por cliente.
    expect(lerCadastroAbertoPersistido("outro-cliente")).toBe(false);
  });
});

describe("cadastro fechado por padrão — render real via renderToStaticMarkup", () => {
  it("os controles editáveis NÃO estão no documento", () => {
    const html = render();

    // Rótulos exclusivos da região recolhível (fora da linha de identidade).
    expect(html).not.toContain("Dia Otimizar");
    expect(html).not.toContain("Data Otimização");
    expect(html).not.toContain("Score de saúde");
    // RECALCULA (ticket 517): a linha de aviso "Closer que fechou e Tempo de
    // casa" (BlocoVazioLinha) passou a viver fora da região recolhível — ela
    // é visível fechado ou aberto, igual já era quando morava solta em
    // page.tsx. Com o dublê deste teste (fichaMock.fechamento = null), a
    // linha aparece mesmo fechado, então "Tempo de casa"/"Closer que fechou"
    // como substring solta deixam de provar ausência: a prova vira o texto
    // exato das CÉLULAS somente-leitura (só existem dentro da região
    // recolhível), delimitado pelas tags que o mock de BlocoVazioLinha não produz.
    expect(html).not.toContain(">Tempo de casa<");
    expect(html).not.toContain(">Closer que fechou<");
    expect(html).not.toContain("Gestor (Analista de Tráfego)");
  });

  it("a linha de identidade permanece visível: nome, status e o botão de abrir", () => {
    const html = render();

    expect(html).toContain("Cliente Teste");
    expect(html).toContain("Ativo");
    expect(html).toContain("Editar cadastro");
    expect(html).toContain('aria-expanded="false"');
  });

  it("o botão é operável por teclado (elemento <button> real, focável por padrão) e aponta pro painel via aria-controls", () => {
    const html = render();

    expect(html).toMatch(/<button[^>]*aria-expanded="false"[^>]*aria-controls="cadastro-cliente-colapsavel-cliente-292"/);
  });

  it("cadastro incompleto continua visível fechado, quando aplicável", () => {
    fichaMock = novoFichaMock({ perfClienteId: null });
    const html = renderToStaticMarkup(
      React.createElement(IdentidadeCliente, { score: SCORE_COM_VALOR, risco: "Baixo", perfResolved: true }),
    );
    expect(html).toContain("Cadastro incompleto");
  });
});

describe("clique em 'Editar cadastro' — handler real capturado e executado", () => {
  it("existe e é uma função de verdade (não é possível montar sem ela)", () => {
    render();
    expect(typeof cliquesCapturados["cadastro-editar-toggle"]).toBe("function");
  });

  it("ao ser chamado, persiste a preferência 'aberto' de verdade (efeito colateral real, síncrono no corpo do handler)", () => {
    globalThis.sessionStorage = criarSessionStorageMock();
    render();

    expect(lerCadastroAbertoPersistido("cliente-292")).toBe(false);
    expect(() => cliquesCapturados["cadastro-editar-toggle"]()).not.toThrow();
    expect(lerCadastroAbertoPersistido("cliente-292")).toBe(true);
  });

  it("não lança mesmo sem sessionStorage no ambiente (try/catch cobre o clique também)", () => {
    render();
    expect(() => cliquesCapturados["cadastro-editar-toggle"]()).not.toThrow();
  });
});

describe("sessão com a preferência 'aberto' — o mesmo valor que o clique grava traz os campos de volta", () => {
  it("com a preferência aberta, um novo render real mostra os campos editáveis e a região recolhível", () => {
    globalThis.sessionStorage = criarSessionStorageMock({ "comarka:ficha:cadastro-aberto:cliente-292": "1" });

    const html = render();

    expect(html).toContain('aria-expanded="true"');
    expect(html).toContain("Dia Otimizar");
    expect(html).toContain("Data Otimização");
    expect(html).toContain("Tempo de casa");
    // RECALCULA (ticket 514): a célula "Score de saúde" saiu da linha 1 do
    // cadastro — o score só aparece pelo chip "Saúde" na linha de
    // identidade (sempre visível, fechado ou aberto). Troca a prova positiva
    // por "Risco de churn" (célula que continua na mesma linha 1) e soma uma
    // prova negativa: a célula antiga não pode ter voltado quando abre.
    expect(html).toContain("Risco de churn");
    expect(html).not.toContain("Score de saúde");
    expect(html).toContain("Gestor (Analista de Tráfego)");
  });

  it("mesmo aberto, a linha de identidade continua visível — nome e status não desaparecem", () => {
    globalThis.sessionStorage = criarSessionStorageMock({ "comarka:ficha:cadastro-aberto:cliente-292": "1" });

    const html = render();

    expect(html).toContain("Cliente Teste");
    expect(html).toContain("Ativo");
  });

  it("com a preferência fechada explícita ('0'), o render nasce fechado", () => {
    globalThis.sessionStorage = criarSessionStorageMock({ "comarka:ficha:cadastro-aberto:cliente-292": "0" });

    const html = render();

    expect(html).toContain('aria-expanded="false"');
    expect(html).not.toContain("Dia Otimizar");
  });
});

describe("Status continua gravando pela rota de sempre, mesmo dentro da região recolhível", () => {
  it("o cartão só usa POST /api/clientes/situacao através de update() para Status — comportamento não mudou", () => {
    const source = readFileSync(GERAL_TAB_PATH, "utf-8");
    expect(source).toContain('update("status", v)');
  });
});
