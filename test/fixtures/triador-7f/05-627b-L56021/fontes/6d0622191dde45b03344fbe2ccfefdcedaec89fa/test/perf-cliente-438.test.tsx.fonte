import { describe, it, expect, vi, beforeEach, afterEach } from "vitest";
import { createElement, type ReactNode } from "react";
// @ts-expect-error — @types/react-dom não está instalado neste projeto (fora
// do escopo deste ticket: instalar dependência não está na allowlist).
import { renderToString } from "react-dom/server";
import DetalhePerformancePage from "@/app/dashboard/clientes/[id]/performance/page";

/**
 * Ticket 323 (React error #438, tela branca em produção).
 *
 * Causa raiz: a página chamava `use(params)` — hook inexistente na versão
 * de React instalada neste projeto (18.3.1; `use()` só existe a partir do
 * React 19) e, além disso, `params` no App Router deste Next (14.2) chega
 * como objeto síncrono, não como Promise. `use` importado de "react" era
 * `undefined`, e `undefined(params)` lançava em TODO render — daí a página
 * sempre quebrar. A correção troca `use(params)` por `useParams()` do
 * `next/navigation` (mesmo padrão já usado em
 * src/app/dashboard/clientes/[id]/page.tsx) e envolve o conteúdo num
 * ErrorBoundary de classe como rede de segurança adicional.
 */

vi.mock("next/navigation", () => ({
  useParams: () => ({ id: "00000000-0000-4000-8000-000000000000" }),
}));

vi.mock("sonner", () => ({
  toast: { error: vi.fn(), success: vi.fn(), warning: vi.fn() },
}));

// O ambiente de teste (vitest.config.ts, fora da allowlist deste ticket) não
// tem @vitejs/plugin-react nem override de `jsx` para módulos fora de
// src/app/dashboard/clientes/[id]/performance/**, então qualquer .tsx real
// desses pacotes de UI quebra o transform do Vite ("jsx: preserve"). Mocka-se
// aqui com componentes equivalentes em createElement (sem JSX) só para este
// teste conseguir montar a árvore — o comportamento visual desses componentes
// já é coberto pelos próprios testes/lint deles, não é o que o #438 quebrou.
vi.mock("@/components/ui/card", () => ({
  Card: ({ children, ...props }: { children?: ReactNode }) =>
    createElement("div", props, children),
  CardContent: ({ children, ...props }: { children?: ReactNode }) =>
    createElement("div", props, children),
}));

vi.mock("@/components/ui/button", () => ({
  Button: ({ children, ...props }: { children?: ReactNode }) =>
    createElement("button", props, children),
}));

vi.mock("@/components/ui/tabs", () => ({
  Tabs: ({ children, ...props }: { children?: ReactNode }) =>
    createElement("div", props, children),
  TabsList: ({ children, ...props }: { children?: ReactNode }) =>
    createElement("div", props, children),
  TabsTrigger: ({ children, ...props }: { children?: ReactNode }) =>
    createElement("button", props, children),
  TabsContent: ({ children, ...props }: { children?: ReactNode }) =>
    createElement("div", props, children),
}));

vi.mock("@/components/dica", () => ({
  Dica: ({ children }: { children?: ReactNode }) => children,
}));

function mockPayload() {
  return {
    periodo: "mes_atual",
    cliente: {
      entrada_id: "00000000-0000-4000-8000-000000000000",
      notion_id: null,
      nome: "Cliente Teste",
      nicho: "estetica",
      categoria: "premium",
      status: "ativo",
      status_financeiro: "em dia",
      situacao: null,
      analista: "Fulano",
      meta_campaign_id: "123",
      meta_adset_id: null,
      meta_leads_mes: 50,
      meta_roas_minimo: 3,
      score_saude: 72,
      score_calculado_em: "2026-09-01T00:00:00.000Z",
      risco_churn: "baixo" as const,
      risco_churn_motivo: null,
      risco_churn_acao: null,
    },
    metricas_periodo: {
      spend: 1000,
      total_leads: 20,
      leads_qualificados: 8,
      cpl: 50,
      roas: 3.2,
      taxa_qualificacao: 0.4,
      pct_meta_leads: 40,
    },
    metricas_comparativo: {
      spend: 900,
      total_leads: 18,
      leads_qualificados: 6,
      cpl: 50,
      roas: 3,
      taxa_qualificacao: 0.33,
      pct_meta_leads: 36,
    },
    historico_mensal: [],
    historico_mensal_ano_anterior: [],
    leads_individuais: [],
    alerta_sem_leads: false,
    teses: [],
    timeline: [],
    benchmark: {
      nicho: "estetica",
      total_clientes: 5,
      score_medio: 65,
      cpl_medio: 55,
      roas_medio: 2.8,
      comparativo: [],
    },
    alertas: [],
    meta_historico: [],
  };
}

describe("performance/[id] — regressão do react error #438 (tela branca)", () => {
  const originalFetch = global.fetch;

  beforeEach(() => {
    global.fetch = vi.fn().mockResolvedValue({
      ok: true,
      json: async () => mockPayload(),
    }) as unknown as typeof fetch;
  });

  afterEach(() => {
    global.fetch = originalFetch;
    vi.restoreAllMocks();
  });

  it("renderiza sem lançar (fetch mockado)", () => {
    expect(() => renderToString(createElement(DetalhePerformancePage))).not.toThrow();
  });

  it("não usa a Promise de params (root cause do #438) — não chama use()", () => {
    // Regressão direta: se alguém reintroduzir `use(params)`, a chamada de
    // função sobre `use` (inexistente no React 18 instalado) lança em todo
    // render, e o teste acima também pegaria — este é só o sinal mais direto.
    expect(() => renderToString(createElement(DetalhePerformancePage))).not.toThrow(
      /is not a function/
    );
  });
});
