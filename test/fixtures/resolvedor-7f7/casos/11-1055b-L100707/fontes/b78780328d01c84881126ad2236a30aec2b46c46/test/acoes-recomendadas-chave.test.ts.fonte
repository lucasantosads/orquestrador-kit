/**
 * Testes obrigatórios — Ticket 363
 *
 * Bug: GET /api/acoes-recomendadas respondia 500 em 100% das chamadas porque
 * src/lib/acoes/motor.ts (coletarClientesPerf) selecionava `clientes.notion_id`
 * — coluna que não existe em `clientes`. A ponte real (ticket 094) é
 * `clientes_notion_mirror.cliente_id ↔ notion_id`.
 *
 * Cobre:
 *  - gerarAcoesRecomendadas resolve notion_id via clientes_notion_mirror (não
 *    via clientes.notion_id) e nunca lança por causa disso;
 *  - cliente cuja ponte não resolve sai da lista de ações e entra na contagem
 *    `sem_cadastro_os` (nunca vira erro nem some silenciosamente);
 *  - GET da rota responde 200 com a lista + a contagem de não resolvidos;
 *  - erro real de banco no GET nunca vaza a mensagem crua do Postgres pro
 *    cliente (card não pode mais mostrar SQL cru).
 */
import { describe, it, expect, vi, beforeEach } from "vitest";

type TableResult = { data: unknown[] | null; error: { code?: string; message: string } | null };

const state = vi.hoisted(() => ({
  tables: {} as Record<string, TableResult>,
}));

function setTable(nome: string, data: unknown[] | null, error: TableResult["error"] = null) {
  state.tables[nome] = { data, error };
}

vi.mock("@supabase/supabase-js", () => {
  function makeChain(tabela: string): object {
    const resultado = (): TableResult => state.tables[tabela] ?? { data: [], error: null };
    const chain: object = new Proxy(
      {},
      {
        get(_t, prop: string) {
          if (prop === "then") {
            return (resolve: (v: unknown) => void) => resolve(resultado());
          }
          if (prop === "catch") return () => chain;
          if (prop === "finally") return (fn: () => void) => { fn(); return chain; };
          if (prop === "maybeSingle" || prop === "single") {
            return () => {
              const r = resultado();
              return Promise.resolve({ data: (r.data ?? [])[0] ?? null, error: r.error });
            };
          }
          return () => chain;
        },
      },
    );
    return chain;
  }
  return { createClient: () => ({ from: (tabela: string) => makeChain(tabela) }) };
});

vi.mock("@/lib/session", () => ({
  getSession: vi.fn(),
}));

import { getSession } from "@/lib/session";
import { gerarAcoesRecomendadas } from "@/lib/acoes/motor";
import { GET } from "@/app/api/acoes-recomendadas/route";

const mockGetSession = vi.mocked(getSession);
const SESSION = { employeeId: "emp-1", role: "admin" as const, entityId: null, nome: "Teste" };

// A tem ponte (clientes_notion_mirror.cliente_id = 'A'); B e C não têm
// nenhuma linha no mirror para o cliente_id delas — "sem cadastro no OS".
function configurarFixturePadrao() {
  for (const k of Object.keys(state.tables)) delete state.tables[k];
  setTable("perf_ad_accounts", [{ cliente_id: "A" }, { cliente_id: "B" }, { cliente_id: "C" }]);
  setTable("clientes", [
    { id: "A", nome: "Cliente A" },
    { id: "B", nome: "Cliente B" },
    { id: "C", nome: "Cliente C" },
  ]);
  setTable("clientes_notion_mirror", [{ cliente_id: "A", notion_id: "notion-A" }]);
}

beforeEach(() => {
  configurarFixturePadrao();
  mockGetSession.mockResolvedValue(SESSION);
});

describe("gerarAcoesRecomendadas — chave via clientes_notion_mirror (ticket 094), não clientes.notion_id", () => {
  it("nunca lança: a coleta não depende de clientes.notion_id", async () => {
    await expect(gerarAcoesRecomendadas()).resolves.toBeDefined();
  });

  it("cliente sem ponte resolvida sai da lista e entra na contagem sem_cadastro_os", async () => {
    const out = await gerarAcoesRecomendadas();
    // B e C não têm linha em clientes_notion_mirror para o cliente_id delas.
    expect(out.sem_cadastro_os).toBe(2);
    expect(out.acoes.every((a) => a.cliente_id !== "B" && a.cliente_id !== "C")).toBe(true);
  });

  it("cliente com ponte resolvida continua gerando ações normalmente", async () => {
    const out = await gerarAcoesRecomendadas();
    expect(out.acoes.some((a) => a.cliente_id === "A")).toBe(true);
  });
});

describe("GET /api/acoes-recomendadas", () => {
  it("responde 200 com a lista de ações + a contagem de não resolvidos", async () => {
    const res = await GET();
    expect(res.status).toBe(200);
    const body = await res.json();
    expect(body.sem_cadastro_os).toBe(2);
    expect(Array.isArray(body.acoes)).toBe(true);
  });

  it("erro de banco nunca vaza a mensagem crua do Postgres pro cliente", async () => {
    setTable("perf_ad_accounts", null, {
      code: "42703",
      message: 'column clientes.notion_id does not exist',
    });
    const res = await GET();
    expect(res.status).toBe(500);
    const body = await res.json();
    expect(body.error).not.toMatch(/notion_id/i);
    expect(body.error).not.toMatch(/column|does not exist|42703/i);
  });
});
