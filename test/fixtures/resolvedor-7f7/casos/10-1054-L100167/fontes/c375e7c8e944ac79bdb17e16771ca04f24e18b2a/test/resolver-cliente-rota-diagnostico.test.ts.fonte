/**
 * Ticket 810: POST /api/clientes/[id]/diagnostico usa resolverCliente (uma vez por requisição).
 * O [id] da rota é o id da linha de receita; o resolver recebe a chave que a linha carrega.
 */
import { describe, it, expect, vi, beforeEach } from "vitest";
import { NextRequest } from "next/server";

const { mockFrom, mockResolver, mockProvider, filtros } = vi.hoisted(() => ({
  mockFrom: vi.fn(),
  mockResolver: vi.fn(),
  mockProvider: vi.fn(),
  filtros: { or: [] as string[] },
}));

vi.mock("@/lib/session", () => ({ getSession: vi.fn(async () => ({ userId: "u" })) }));
vi.mock("@/lib/ia/provider", () => ({ chamarProvider: mockProvider }));
vi.mock("@supabase/supabase-js", () => ({ createClient: () => ({ from: mockFrom }) }));
vi.mock("@/lib/clientes/resolver-cliente", async () => {
  const real = await vi.importActual<typeof import("@/lib/clientes/resolver-cliente")>("@/lib/clientes/resolver-cliente");
  return { ...real, resolverCliente: mockResolver };
});

import { POST } from "@/app/api/clientes/[id]/diagnostico/route";

const CLIENTE = "00000000-0000-4000-8000-000000000000";
const NOTION = "11111111-1111-4111-8111-111111111111";
const RECEITA = "22222222-2222-4222-8222-222222222222";

function cadeia(resultado: unknown, tabela: string) {
  const c: Record<string, unknown> = {};
  for (const m of ["select", "eq", "is", "order", "limit"]) c[m] = () => c;
  c.or = (f: string) => {
    if (tabela === "reunioes_cliente") filtros.or.push(f);
    return c;
  };
  c.maybeSingle = () => Promise.resolve(resultado);
  c.then = (ok: (v: unknown) => unknown, ko?: (e: unknown) => unknown) => Promise.resolve(resultado).then(ok, ko);
  return c;
}

function montar(opts: { entrada: unknown; mirror?: unknown }) {
  mockFrom.mockImplementation((t: string) => {
    if (t === "clientes_receita") return cadeia({ data: opts.entrada, error: null }, t);
    if (t === "clientes_notion_mirror") return cadeia({ data: opts.mirror ?? null, error: null }, t);
    return cadeia({ data: [], error: null }, t);
  });
}

const chamar = () =>
  POST(new NextRequest(`http://localhost/api/clientes/${RECEITA}/diagnostico`, { method: "POST", body: "{}" }), {
    params: Promise.resolve({ id: RECEITA }),
  });

const ENTRADA = { id: RECEITA, nome: "Acme", valor_mensal: 1, categoria: "x", status_financeiro: "ok", cliente_id: CLIENTE };

beforeEach(() => {
  vi.clearAllMocks();
  filtros.or = [];
  mockProvider.mockResolvedValue({ texto: "ok" });
});

describe("diagnostico: resolverCliente", () => {
  it("(a)(b) chave em uuid e em notion_id chegam à mesma consulta por cliente_id", async () => {
    // O resolver devolve o mesmo par nos dois casos; a consulta de reuniões é a mesma.
    mockResolver.mockResolvedValue({ cliente_id: CLIENTE, notion_id: NOTION });
    montar({ entrada: ENTRADA, mirror: { notion_id: NOTION, nicho: null, analista: null, cliente_id: CLIENTE } });
    expect((await chamar()).status).toBe(200);
    montar({ entrada: { ...ENTRADA, cliente_id: null }, mirror: { notion_id: NOTION, nicho: null, analista: null, cliente_id: null } });
    expect((await chamar()).status).toBe(200);
    expect(mockResolver).toHaveBeenCalledTimes(2);
    expect(mockResolver.mock.calls[0][0]).toBe(CLIENTE);
    expect(mockResolver.mock.calls[1][0]).toBe(NOTION);
    expect(filtros.or).toHaveLength(2);
    expect(filtros.or[0]).toBe(filtros.or[1]);
    expect(filtros.or[0]).toContain(`cliente_id.eq."${CLIENTE}"`);
  });

  it("(c) sem vínculo (sem cliente_id e sem ponte) segue 200, sem resolver e sem consultar reuniões", async () => {
    montar({ entrada: { ...ENTRADA, cliente_id: null } });
    const res = await chamar();
    expect(res.status).toBe(200);
    expect(mockResolver).not.toHaveBeenCalled();
    expect(filtros.or).toHaveLength(0);
  });

  it("(c2) par sem cliente_id mas com ponte ainda lê pela ponte, como antes", async () => {
    mockResolver.mockResolvedValue({ cliente_id: null, notion_id: NOTION });
    montar({ entrada: { ...ENTRADA, cliente_id: null }, mirror: { notion_id: NOTION, nicho: null, analista: null, cliente_id: null } });
    expect((await chamar()).status).toBe(200);
    expect(filtros.or[0]).toContain(`cliente_notion_id.eq."${NOTION}"`);
  });

  it("(d) linha de receita desconhecida = 404", async () => {
    montar({ entrada: null });
    const res = await chamar();
    expect(res.status).toBe(404);
    expect((await res.json()).error).toBe("Cliente não encontrado");
  });

  it("(e) resolver que lança = 500 com a mensagem", async () => {
    mockResolver.mockRejectedValue(new Error("falha de leitura"));
    montar({ entrada: ENTRADA });
    const res = await chamar();
    expect(res.status).toBe(500);
    expect((await res.json()).error).toBe("falha de leitura");
    expect(mockProvider).not.toHaveBeenCalled();
  });
});
