});

describe("abas", () => {
  const aba = (i: number, rotuloEsperado: string) => {
    // Ticket 671 (decisão de 26/09): Comercial é a 5ª aba (mockup e TAB_GROUPS); 4 + 1 = 5.
    expect(ABAS_MOCKUP).toHaveLength(5);
    expect(ABAS_MOCKUP[i]).toBe(rotuloEsperado);
    expect(TAB_GROUPS).toHaveLength(5);
    expect(TAB_GROUPS.map((g) => g.label)).toEqual(ABAS_MOCKUP);
    expect(TAB_GROUPS[i].label).toBe(ABAS_MOCKUP[i]);
    // a ficha desenha as abas a partir de TAB_GROUPS
    expect(pageCodigo).toMatch(/TAB_GROUPS\.filter[^]*?\{g\.label\}/);
  };
  it("abas: Visao", () => aba(0, "Visão"));
  it("abas: Campanhas", () => aba(1, "Campanhas"));
  it("abas: Relacao", () => aba(2, "Relação"));
  it("abas: Conta", () => aba(3, "Conta"));
  it("abas: Comercial", () => aba(4, "Comercial"));
});

describe("barra da Visão", () => {
  const barraMod = carregar(caminhoComp("barra-visao"), { "next/link": linkStub });
  const BarraVisao = barraMod.BarraVisao as React.ComponentType<Record<string, unknown>>;
  const barra = html(React.createElement(BarraVisao, {
    clienteId: null, resolvido: false, setupHref: "/x", modoPeriodo: "30d", setModoPeriodo: () => {},
    customInicio: "", setCustomInicio: () => {}, customFim: "", setCustomFim: () => {},
    avisoPersonalizado: null, contaSel: "all", setContaSel: () => {},
  }));

  it("barra: seletor de conta", () => {
    expect(mockup).toContain('<span class="muted">Conta</span>');
    expect(mockup).toContain("Todas as contas");
    expect(barra).toMatch(/<select[^>]*data-testid="barra-visao-conta"/);
    expect(textoDe(barra)).toMatch(/Conta\s+Todas as contas/);
    expect(ocorrencias(ramoVisao, "BarraVisao")).toHaveLength(1);
  });

  it("barra: nicho da conta", () => {
    expect(mockup).toContain("Nicho da conta");
    expect(textoDe(barra)).toContain("Nicho da conta");
    // com conta em foco vira seletor que grava por PUT
    expect(semComentarios(fonte["barra-visao"])).toMatch(/data-testid="barra-visao-nicho"/);
    expect(fonte["barra-visao"]).toContain("/api/perf/contas/${contaId}/nicho");
  });

  it("barra: um seletor de periodo com os seis presets do seletor padrão", () => {
    // Lote B (29/09): a especificação do seletor padrão do OS substitui as oito
    // opções do mockup (que continua com 8, documento dos tickets 491/521) por
    // seis presets, nesta ordem; 14d, 30d, 90d e "Mês ant." saem.
    expect(PERIODOS_MOCKUP.map(trocar)).toEqual(["Hoje", "7d", "14d", "30d", "Este mês", "Mês ant.", "90d", "Personalizado"]);
    const esperado = ["Hoje", "Esta semana", "Este mês", "Mês passado", "Últimos 7 dias", "Personalizado"];
    const grupo = /<div[^>]*role="group"[^>]*aria-label="Período da aba"[^>]*>([^]*?)<\/div>/.exec(barra);
    expect(grupo, "grupo de período não renderizado").not.toBeNull();
    expect(todos(/<button[^>]*>([^<]*)<\/button>/g, grupo![1])).toEqual(esperado);
    expect(barra).not.toContain(">Custom<");
    // exatamente um seletor de período na Visão
    expect(contar(barra, /aria-label="Período da aba"/g)).toBe(1);
    expect(contar(barra, /data-testid="barra-visao-periodo"/g)).toBe(1);
    expect(geralCodigo).not.toMatch(/MODOS_PERIODO|aria-label="Período|setModoPeriodo/);
    for (const c of MONTADOS_NA_VISAO.filter((x) => x !== "barra-visao")) {
      expect(semComentarios(fonte[c]), c).not.toMatch(/MODOS_PERIODO|aria-label="Período|Mês ant\./);
    }
  });
});

describe("KPIs", () => {
  const kpisMod = carregar(caminhoComp("kpis-visao"), { sonner: sonnerStub });
  const montarKpis = kpisMod.montarKpis as (e: unknown) => { chave: string; rotulo: string }[];
  const FaixaKpis = kpisMod.FaixaKpis as React.ComponentType<{ kpis: unknown }>;
  const MaisMetricas = kpisMod.MaisMetricas as React.ComponentType<Record<string, unknown>>;
  const SEM_CONTA = {
    contaVinculada: false, midiaCarregando: false, midia: null, crmCarregando: false, crmConexao: "desconectado", crm: null,
  };
  const COM_BASE = {
    contaVinculada: true, midiaCarregando: false,
    midia: { gasto: 3000, leads: 60, impressoes: 100000, cliques: 1500, dias: 30 },
    crmCarregando: false, crmConexao: "conectado", crm: { leads: 50, mql: 20, anterior: null },
  };
  const faixa = html(React.createElement(FaixaKpis, { kpis: montarKpis(COM_BASE) }));
  const faixaSemConta = html(React.createElement(FaixaKpis, { kpis: montarKpis(SEM_CONTA) }));

  const kpi = (i: number, rotuloEsperado: string) => {
    expect(KPIS_MOCKUP).toHaveLength(6);
    expect(KPIS_MOCKUP[i]).toBe(rotuloEsperado);
    const rotulo = trocar(KPIS_MOCKUP[i]);
    expect(montarKpis(COM_BASE).map((k) => k.rotulo)).toEqual(KPIS_MOCKUP.map(trocar));
    expect(textoDe(faixa)).toContain(rotulo);
    expect(faixa).toMatch(new RegExp(`data-testid="kpi-${montarKpis(COM_BASE)[i].chave}"`));
    // montada na Visão
    expect(geralCodigo).toMatch(/<KpisVisao[^]*?\/>/);
  };
  /** CAC e ROAS: o "s/ dado" do mockup vira "sem base" com motivo. */
  const ausenciaTrocada = (i: number) => {
    const chave = montarKpis(COM_BASE)[i].chave;
    const cel = new RegExp(`data-testid="kpi-${chave}"[^>]*>([^]*?)(?=<div[^>]*data-testid="kpi-|$)`).exec(faixa);
    expect(cel).not.toBeNull();
    const t = textoDe(cel![1]);
    expect(t).toContain(trocar("s/ dado"));
    expect(t).not.toContain("s/ dado");
    expect(t).not.toMatch(/R\$\s*0/);
  };

  it("kpis: Investimento", () => kpi(0, "Investimento"));
  it("kpis: CPL", () => kpi(1, "CPL"));
  it("kpis: % MQL", () => kpi(2, "% MQL"));
  it("kpis: CPMQL", () => kpi(3, "CPMQL"));
  it("kpis: CAC", () => { kpi(4, "CAC"); ausenciaTrocada(4); });
  it("kpis: ROAS", () => { kpi(5, "ROAS"); ausenciaTrocada(5); });

  it("kpis: Mais metricas", () => {
    expect(mockup).toContain("Mais métricas (");
    const h = html(React.createElement(MaisMetricas, { entrada: COM_BASE, escolhidas: ["ctr"], aoEscolher: () => {} }));
    expect(h).toMatch(/<button[^>]*data-testid="mais-metricas-toggle"[^>]*>[^]*?Mais métricas/);
    // nasce colapsada, como no mockup (bloco .extra vazio até clicar)
    expect(h).toContain('aria-expanded="false"');
    expect(h).not.toContain('data-testid="mais-metricas-corpo"');
    expect(faixaSemConta).toContain("sem base");
  });

  it("kpis: Escolher metricas", () => {
    expect(mockup).toContain("⚙ Escolher métricas");
    expect(mockup).toContain('aria-label="Escolher métricas"');
    const h = html(React.createElement(MaisMetricas, { entrada: COM_BASE, escolhidas: ["ctr"], aoEscolher: () => {} }));
    // 29/09: botão só de ícone (Settings2, ghost) com a dica "Escolher métricas", que é
    // também o nome acessível, como o aria-label do mockup.
    expect(h).toMatch(/<button[^>]*aria-label="Escolher métricas"[^>]*data-testid="escolher-metricas"|<button[^>]*data-testid="escolher-metricas"[^>]*aria-label="Escolher métricas"/);
    expect(h).toMatch(/data-testid="escolher-metricas"[^>]*>\s*<svg[^>]*lucide-settings2/);
    // o drawer aberto traz o mesmo título
    const drawerMod = carregar(caminhoComp("drawer-metricas"));
    const Drawer = drawerMod.DrawerMetricas as React.ComponentType<Record<string, unknown>>;
    const d = html(React.createElement(Drawer, { aberto: true, escolhidas: ["ctr"], aoFechar: () => {}, aoSalvar: () => {} }));
    expect(d).toContain('data-testid="drawer-metricas"');
    expect(textoDe(d)).toContain("Escolher métricas");
  });
});

describe("tabela de campanhas", () => {
  const tabMod = carregar(caminhoComp("tabela-campanhas"), {
    sonner: sonnerStub,
    "../tabs/ficha-context": { useFicha: () => ({}) },
  });
  const CorpoTabela = tabMod.CorpoTabela as React.ComponentType<Record<string, unknown>>;
  const celulasMetricas = tabMod.celulasMetricas as (c: unknown, s?: string, rastreado?: boolean) => Record<string, { texto: string; ausente: boolean }>;
  const COLUNAS = tabMod.COLUNAS_CAMPANHAS as readonly string[];
  const chaveConjunto = tabMod.chaveConjunto as (c: string, a: string) => string;
  const estado = { tipos: { c1: "lp" }, teseDe: {}, catalogo: [], statusDe: { c1: "ACTIVE" } };
  const contas = [{
    // 649: rastreia MQL; sem o sinal as colunas de CRM não são renderizadas.
    ad_account_id: "a1", act_id: "act_1", nicho: null, mql_rastreado: true,
    // Lote C: L.Meta vem do resultado da Meta; os 10 leads viram 10 conversas em `resultados`.
    campaigns: [{
      campaign_id: "c1", campaign_nome: "Campanha LT2", gasto: 1000, impressoes: 100, cliques: 10, leads: 10, mqls: 4, pct_mql: 40,
      resultados: [{ indicador: "actions:onsite_conversion.messaging_conversation_started_7d", qtd: 10 }],
    }],
  }];
  const nop = () => {};

  it("tabela: colunas do mockup com fonte", () => {
    const doMockup = COLUNAS_MOCKUP.filter((c) => !COLUNAS_FORA_DO_ACEITE.includes(c)).map(trocar);
    expect(COLUNAS_MOCKUP).toHaveLength(12);
    expect(doMockup).toEqual(["Campanha", "Funil", "Tese", "Status", "Investido", "Leads", "CPL", "MQL", "% MQL", "CPMQL"]);
    // Lote C (29/09): ordem aprovada com 16 colunas. Leads virou L.Meta e % MQL
    // virou %MQL só nesta tabela (o KPI do topo segue "% MQL", por isso a troca é
    // local e não entra em TROCAS). As colunas do mockup continuam em ordem.
    const renomeiaLoteC: Record<string, string> = { Leads: "L.Meta", "% MQL": "%MQL" };
    const esperado = [
      "Campanha", "Funil", "Tese", "Status", "Investido", "L.Meta", "L.CRM", "Div%",
      "CPL", "MQL", "%MQL", "CPMQL", "R.Ag", "R.Feita", "Vendas", "CAC",
    ];
    let i = 0;
    const doMockupRenomeado = doMockup.map((c) => renomeiaLoteC[c] ?? c);
    for (const c of esperado) if (c === doMockupRenomeado[i]) i++;
    expect(i).toBe(doMockupRenomeado.length);
    expect([...COLUNAS]).toEqual(esperado);
    const h = html(React.createElement(CorpoTabela, { contas, estado, filtro: "todos", salvandoId: null, onTipo: nop, onTese: nop }));
    expect(todos(/<th[^>]*>([^<]*)<\/th>/g, h)).toEqual(esperado);
    // "Leads CRM" não tem fonte: nunca aparece na tela
    expect(semComentarios(fonte["tabela-campanhas"])).not.toContain("Leads CRM");
    // cada coluna de número vem do payload da campanha
    // Ticket 634: com fonte de MQL (sinal true) os valores seguem medidos; sem o sinal seriam sem base.
    const cel = celulasMetricas(contas[0].campaigns[0], "ACTIVE", true);
    expect(cel.status.texto).toBe("Ativa");
    expect(cel.investimento.texto).toMatch(/1\.000,00/);
    // Lote C: a coluna Leads virou L.Meta (chave l_meta): 10 conversas.
    expect(cel.l_meta.texto).toBe("10");
    expect(cel.cpl.texto).toMatch(/100,00/);
    expect(cel.mql.texto).toBe("4");
    // Lote C: 4 MQL / 10 conversas (L.Meta de captação) = 40,0%.
    expect(cel.pct_mql.texto).toBe("40,0%");
    expect(cel.cpmql.texto).toMatch(/250,00/);
    // sem fonte de MQL: sem base, nunca "s/ dado" nem 0
    const semMql = celulasMetricas({ ...contas[0].campaigns[0], mqls: undefined }, "ACTIVE");
    expect(semMql.mql.texto).toBe(trocar("s/ dado"));
    expect(semMql.cpmql.texto).toBe("sem base");
  });

  it("tabela: expansao ate anuncio", () => {
    function pronto<T>(dados: T) { return { tipo: "pronto" as const, dados }; }
    const expansao = {
      podeExpandir: true,
      campanhasAbertas: { c1: true },
      conjuntosAbertos: { [chaveConjunto("c1", "as1")]: true },
      breakdown: pronto([{ campaign_id: "c1", adsets: [{
        adset_id: "as1", gasto: 500, impressoes: 10, cliques: 1, leads: 5, mqls: 2, pct_mql: 40,
        ads: [{ ad_id: "ad1", gasto: 200, impressoes: 5, cliques: 1, leads: 2, mqls: 1, pct_mql: 50 }],
      }] }]),
      conjuntos: { c1: pronto([{ id: "as1", nome: "Conjunto Broad", status: "ACTIVE" }]) },
      anuncios: { as1: pronto([{ id: "ad1", nome: "Anuncio 01", status: "ACTIVE" }]) },
      onCampanha: nop, onConjunto: nop,
    };
    const h = html(React.createElement(CorpoTabela, { contas, estado, filtro: "todos", salvandoId: null, onTipo: nop, onTese: nop, expansao }));
    // campanha (aria-expanded) -> conjunto (nível 1) -> anúncio (nível 2)
    expect(contar(h, /<button[^>]*aria-expanded="true"/g)).toBeGreaterThanOrEqual(2);
    expect(h).toContain("Campanha LT2");
    expect(h).toMatch(/data-nivel="1"[^]*?Conjunto Broad/);
    expect(h).toMatch(/data-nivel="2"[^]*?Anuncio 01/);
    // sem expansão a tabela é plana e o botão fica desabilitado
    const plana = html(React.createElement(CorpoTabela, { contas, estado, filtro: "todos", salvandoId: null, onTipo: nop, onTese: nop }));
    expect(plana).toMatch(/<button[^>]*aria-expanded="false"[^>]*disabled/);
    // o período da barra chega à tabela
    expect(geralCodigo).toMatch(/<TabelaCampanhas[^]*?periodo=\{metricasData\?\.period\}/);
  });
});

describe("blocos da Visão", () => {
  /** O bloco monta sem condição própria dentro da aba Geral, e a aba Geral monta sem condição na Visão. */
  const montadoNaVisao = (nome: string) => {
    expect(semCondicao(geralCodigo, nome, NUNCA).length, `<${nome} não montado em geral-tab`).toBeGreaterThan(0);
    expect(ramoVisao).toMatch(/<AnchorBlock id="geral"[^>]*>\s*<GeralTab \/>\s*<\/AnchorBlock>/);
  };
  const timelineMod = carregar(caminhoComp("timeline-visao"));
  const TimelineVisaoView = timelineMod.TimelineVisaoView as React.ComponentType<Record<string, unknown>>;
  const vazias = () => {
    const ok = { estado: "ok", itens: [] };
    return { status: ok, reunioes: ok, alertas: ok, combinados: ok };
  };

  it("blocos: Relacao com titulo", () => {
    expect(mockup).toContain("Relação");
    expect(semComentarios(fonte["bloco-relacao"])).toMatch(/<h3[^>]*>Relação<\/h3>/);
    montadoNaVisao("BlocoRelacao");
  });

  it("blocos: Sinais de risco", () => {
    const relMod = carregar(caminhoComp("bloco-relacao"));
    const SinaisDeRisco = relMod.SinaisDeRisco as React.ComponentType<{ estado: unknown }>;
    const lido = html(React.createElement(SinaisDeRisco, { estado: { tipo: "lido", dados: { risco_churn: "alto", risco_churn_motivo: null } } }));
    expect(textoDe(lido)).toContain("Sinais de risco");
    expect(textoDe(lido)).toContain("Risco de churn alto");
    const semBase = html(React.createElement(SinaisDeRisco, { estado: { tipo: "lido", dados: { risco_churn: null } } }));
    expect(textoDe(semBase)).toMatch(/Sinais de risco · sem base/);
    expect(semBase).not.toMatch(/[—–]/);
    montadoNaVisao("BlocoRelacao");
  });

  it("blocos: Tarefas", () => {
    expect(mockup).toContain("<h3>Tarefas</h3>");
    const cod = semComentarios(fonte["bloco-tarefas"]);
    expect(cod).toMatch(/>Tarefas<\//);
    expect(cod).toContain('data-testid="bloco-tarefas"');
    montadoNaVisao("BlocoTarefas");
  });

  it("blocos: Alertas", () => {
    expect(mockup).toContain("<h3>Alertas</h3>");
    const cod = semComentarios(fonte["bloco-alertas"]);
    expect(cod).toMatch(/>Alertas<\//);
    expect(cod).toContain('data-testid="bloco-alertas"');
    expect(cod).toContain("Criar alerta");
    montadoNaVisao("BlocoAlertas");
  });

  it("blocos: Timeline", () => {
    // o título do mockup é "Linha do tempo", sem troca no mapa
    expect(mockup).toContain("<h3>Linha do tempo</h3>");
    expect(TROCAS["Linha do tempo"]).toBeUndefined();
    // 650: vazio é linha sem heading; o h3 do mockup volta com pelo menos um evento.
    const h = html(React.createElement(TimelineVisaoView, { cargas: vazias(), otimizacoes: [] }));
    expect(h).not.toMatch(/<h3/);
    const umaOtim = { id: "o1", notion_id: "n1", data: "2026-09-15", feito: "Orçamento", comentarios: null, proxima_vez: null, solicitado: null, deleted_at: null };
    const comEvento = html(React.createElement(TimelineVisaoView, { cargas: vazias(), otimizacoes: [umaOtim] }));
    expect(comEvento).toMatch(/<h3[^>]*>Linha do tempo<\/h3>/);
    expect(h).not.toMatch(/>Timeline<\/(h3|span)>/);
    expect(fonte["timeline-visao"]).not.toMatch(/>Timeline<\/(h3|span)>/);
    // 29/09: na Visão a Linha do tempo é a primeira linha do cartão Atividade do período.
    montadoNaVisao("AtividadePeriodo");
  });

  it("blocos: Otimizacoes", () => {
    expect(mockup).toContain("<h3>Otimizações</h3>");
    const Bloco = carregar(caminhoComp("bloco-otimizacoes")).BlocoOtimizacoes as React.ComponentType<Record<string, unknown>>;
    const item = { id: "o1", data: "2026-09-15", feito: "Pausados ADS 01, 02 e 04", comentarios: null, deleted_at: null };
    const com = html(React.createElement(Bloco, { otimizacoes: [item], onAbrir: () => {} }));
    // 29/09: linha do cartão Atividade do período; o rótulo "Otimizações" é texto (o
    // cartão dá o título da seção). Sem período por prop, conta todas: 1 no período.
    // O item vira "15/09 · <tipo> · <autor>": "Pausados..." não casa tipo conhecido,
    // daí "alteração"; sem autor na fixture, "s/ autor".
    expect(com).not.toMatch(/<h[1-6]/);
    expect(textoDe(com)).toContain("Otimizações");
    expect(textoDe(com)).toContain("1 no período");
    expect(textoDe(com)).toContain("15/09 · alteração · s/ autor");
    const sem = html(React.createElement(Bloco, { otimizacoes: [], onAbrir: () => {} }));
    expect(sem).not.toMatch(/<h[1-6]/);
    expect(textoDe(sem)).toContain("Otimizações Nenhuma no período Registrar otimização");
    montadoNaVisao("BlocoOtimizacoes");
  });

  it("blocos: Analise IA colapsada", () => {
    expect(mockup).toContain("<b>Análise IA</b>");
    expect(mockup).toContain('id="iaBody"');
    const AnaliseIAView = carregar(caminhoComp("analise-ia"), { sonner: sonnerStub }).AnaliseIAView as React.ComponentType<Record<string, unknown>>;
    const analise = {
      id: "00000000-0000-4000-8000-0000000000bb", created_at: "2026-09-20T12:00:00Z", resumo: "CPMQL acima do teto.",
      status: "concluida", tarefa_id: null,
      diagnostico: [{ area: "Custo", severidade: "P0", observacao: "Gasto sem MQL", evidencia: "x" }],
      plano_acao: [{ acao: "Pausar conjunto", motivo: "sem MQL", impacto: "alto", prioridade: "P0" }],
    };
    const fechada = html(React.createElement(AnaliseIAView, { analise, credencial: true, contaVinculada: true }));
    expect(textoDe(fechada)).toContain("Análise IA");
    expect(fechada).toContain('aria-expanded="false"');
    expect(fechada).not.toContain("Transformar em tarefas");
    // aberta mostra o corpo: prova que o "fechada por padrão" não é só ausência de conteúdo
    const aberta = html(React.createElement(AnaliseIAView, { analise, credencial: true, contaVinculada: true, abertoInicial: true }));
    expect(aberta).toContain("Transformar em tarefas");
    montadoNaVisao("AnaliseIA");
  });
});

