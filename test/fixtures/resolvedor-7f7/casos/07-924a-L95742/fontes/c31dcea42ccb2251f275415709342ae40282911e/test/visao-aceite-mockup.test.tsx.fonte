    expect(page).toMatch(/<Button[^>]*onClick=\{\(\) => setShowBriefing\(true\)\}[^>]*>[^]*?Briefing[^]*?<\/Button>/);
    expect(page.indexOf("setShowBriefing(true)")).toBeLessThan(page.indexOf("<IdentidadeCliente"));
    expect(corpoCartao).not.toContain("Briefing");
  });

  it("cabecalho: Marcar como revisado", () => {
    expect(mockupTopo).toContain("Marcar como revisado");
    expect(mockupCartao).not.toContain("Marcar como revisado");
    expect(page).toMatch(/<Button[^>]*onClick=\{registrarVerificacao\}[^>]*>[^]*?Marcar como revisado[^]*?<\/Button>/);
    expect(page.indexOf("Marcar como revisado")).toBeLessThan(page.indexOf("<IdentidadeCliente"));
    expect(corpoCartao).not.toContain("Marcar como revisado");
  });

  it("cabecalho: linha do Closer dentro do cartao", () => {
    const rotulo = "Closer que fechou e Tempo de casa";
    // sem fonte de fechamento: a linha existe e mora dentro do cartão
    expect(textoDe(cartao({ fechamento: null }))).toContain(rotulo);
    expect(corpoCartao).toContain(`rotulo="${rotulo}"`);
    // e não solta em page.tsx nem na aba
    expect(pageCodigo).not.toContain(rotulo);
    expect(semComentarios(corpoDaFuncao(geral, "GeralTab"))).not.toContain(rotulo);
