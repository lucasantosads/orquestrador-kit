const corpoDaVisao = `${shellDaVisao}\n${geralCodigo}`;

// ─── Análise de montagem ────────────────────────────────────────────────────
function ocorrencias(src: string, nome: string): number[] {
  const re = new RegExp(`<${nome}(?![A-Za-z0-9_])`, "g");
  const idx: number[] = [];
  let m: RegExpExecArray | null;
  while ((m = re.exec(src)) !== null) idx.push(m.index);
  return idx;
}
/** Ocorrências de <Nome que NÃO vêm imediatamente atrás da guarda dada (ou seja, montam sem condição). */
function semCondicao(src: string, nome: string, guarda: RegExp): number[] {
  return ocorrencias(src, nome).filter((i) => !guarda.test(src.slice(Math.max(0, i - 240), i).trimEnd()));
}
const NUNCA = /(?!)/;
const guardaAba = (chave: string) => new RegExp(`activeTab === "${chave}"\\s*(\\?|&&)\\s*\\(?$`);
const GUARDA_NAO_ATIVO = /!isClienteAtivo\([^)]*\)\s*&&\s*\(?$/;

/** Especificadores de import de valor (import type não conta). */
function importsDeValor(src: string): string[] {
  const cod = semComentarios(src).replace(/import type [^;]*;/g, "");
  const out: string[] = [];
  const re = /(?:from|import\(|require\()\s*"([^"]+)"/g;
  let m: RegExpExecArray | null;
  while ((m = re.exec(cod)) !== null) out.push(m[1]);
  return out;
}

// ─── Leitura do mockup ──────────────────────────────────────────────────────
function textoDe(html: string): string {
  return html.replace(/<[^>]+>/g, " ").replace(/&amp;/g, "&").replace(/\s+/g, " ").trim();
}
function todos(re: RegExp, src: string): string[] {
  const out: string[] = [];
  let m: RegExpExecArray | null;
  while ((m = re.exec(src)) !== null) out.push(m[1]);
  return out;
}
const mockupTopo = recorte(mockup, "<!-- TOPO -->", "<!-- CARTÃO DO CLIENTE -->");
const mockupCartao = recorte(mockup, '<section class="client">', "<!-- ABAS + PERÍODO ÚNICO -->");
const mockupAbas = recorte(mockup, '<div class="tabs">', '<div class="period"');
const mockupPeriodo = recorte(mockup, '<div class="period" id="period">', "</div>");
const mockupKpis = recorte(mockup, '<div class="kpis has-data">', '<div class="kpis no-data">');
const mockupTabela = recorte(mockup, '<table class="has-data">', "</tr></thead>");

const ABAS_MOCKUP = todos(/<button class="tab[^"]*">([^<]+)<\/button>/g, mockupAbas);
const PERIODOS_MOCKUP = todos(/<button[^>]*>([^<]+)<\/button>/g, mockupPeriodo);
const KPIS_MOCKUP = todos(/<div class="l">([^<]+)<\/div>/g, mockupKpis);
