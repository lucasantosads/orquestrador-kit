function fichaCom(o: FichaOverrides): Record<string, unknown> {
  return {
    id: "00000000-0000-4000-8000-000000000522",
    cliente: { nome: "AQUINO ADV", status: "Ativo", analista: "Fernando", situacao: "Em dia", atencao: "Verde", nicho: "Previdenciário" },
    update: async () => {}, setCliente: () => {}, gestores: [],
    extra: { whatsapp_group_url: "https://chat.whatsapp.com/grupo-aquino" },
    fechamento: o.fechamento === undefined ? null : o.fechamento,
    perfClienteId: "p1",
    editingPlataforma: false, setEditingPlataforma: () => {}, editingNicho: false, setEditingNicho: () => {},
    nichoOpts: [], salvarExtra: async () => {}, executandoCampoCliente: false,
    npsToken: o.npsToken === undefined ? "token-nps" : o.npsToken, setNpsToken: () => {},
    npsTokenBusy: false, setNpsTokenBusy: () => {},
    contratoData: o.contratoData === undefined ? null : o.contratoData,
    setActiveTab: () => {},
    teses: o.teses ?? [], entregaveis: o.entregaveis ?? [],
    statusHistorico: [], showHistorico: false, setShowHistorico: () => {},
  };
}
// Ticket 711b3: mesma função que o shell usa para resolver o chip da Saúde (page.tsx via lerSinalCliente).
function cartao(o: FichaOverrides = {}, chip: unknown = chipSaude({ cor: "verde", sinal: "ok", motivo: "Sem alertas", faltando: [] })): string {
  fichaAtual = fichaCom(o);
  return html(React.createElement(IdentidadeCliente, { chip, risco: "Baixo", perfResolved: true }));
}
const diaIso = (delta: number): string => {
  const d = new Date();
  d.setDate(d.getDate() + delta);
  return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
};
const TESES_3 = [{ id: "t1" }, { id: "t2" }, { id: "t3" }];
const ENTREGAVEIS_4_DE_7 = [100, 100, 100, 100, 20, 0, 0].map((progresso) => ({ progresso }));

/** Corpo de uma função exportada do geral-tab, até o próximo `export function`. */
function corpoDaFuncao(src: string, nome: string): string {
  const ini = src.indexOf(`export function ${nome}(`);
  if (ini < 0) throw new Error(`função ${nome} não encontrada`);
  const prox = src.indexOf("\nexport function ", ini + 1);
  return src.slice(ini, prox < 0 ? undefined : prox);
}
const corpoCartao = semComentarios(corpoDaFuncao(geral, "IdentidadeCliente"));

