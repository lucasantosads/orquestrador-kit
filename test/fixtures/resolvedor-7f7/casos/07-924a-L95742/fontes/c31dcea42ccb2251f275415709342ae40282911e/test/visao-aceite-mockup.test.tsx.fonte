describe("ausentes da Visão (nada monta sem condição)", () => {
  /** Nem o geral-tab nem os componentes montados na Visão importam o módulo. */
  const naoImportado = (...modulos: string[]) => {
    const imports = [...importsDeValor(geral), ...MONTADOS_NA_VISAO.flatMap((c) => importsDeValor(fonte[c]))];
    for (const mod of modulos) expect(imports.filter((i) => i.includes(mod)), `import de ${mod} na Visão`).toEqual([]);
  };
  const semNaVisao = (nome: string) => {
    expect(semCondicao(corpoDaVisao, nome, NUNCA), `<${nome} montado na Visão`).toEqual([]);
    for (const c of MONTADOS_NA_VISAO) expect(ocorrencias(semComentarios(fonte[c]), nome), `${nome} em ${c}`).toEqual([]);
  };
  const painel = semComentarios(lerArq(resolve(RAIZ, "src/app/dashboard/clientes/perf/_components/ClientePerfPanel.tsx")));
  const textoAusente = (texto: string) => {
    expect(geralCodigo).not.toContain(texto);
    for (const c of MONTADOS_NA_VISAO) expect(semComentarios(fonte[c]), c).not.toContain(texto);
  };

  it("ausente da Visao: ClientePerfPanel", () => {
    semNaVisao("ClientePerfPanel");
    naoImportado("ClientePerfPanel");
    expect(ocorrencias(ramoPerformance, "ClientePerfPanel").length).toBeGreaterThan(0);
  });

  it("ausente da Visao: Pacing de verba", () => {
    // vive dentro do ClientePerfPanel: sai com ele
    expect(painel).toContain("Pacing de verba");
    semNaVisao("ClientePerfPanel");
    textoAusente("Pacing de verba");
  });

  it("ausente da Visao: Metas", () => {
    expect(painel).toMatch(/Metas/);
    semNaVisao("ClientePerfPanel");
    expect(geralCodigo).not.toMatch(/\bMetas\b/);
    for (const c of MONTADOS_NA_VISAO) expect(semComentarios(fonte[c]), c).not.toMatch(/\bMetas\b/);
  });

  it("ausente da Visao: Performance por tipo de campanha", () => {
    expect(painel).toContain("Performance por tipo de campanha");
    semNaVisao("ClientePerfPanel");
    textoAusente("Performance por tipo de campanha");
  });

  it("ausente da Visao: Contas de anuncio", () => {
    expect(painel).toContain("Contas de anúncio");
    semNaVisao("ClientePerfPanel");
    textoAusente("Contas de anúncio");
  });

  it("ausente da Visao: bloco Health", () => {
    semNaVisao("CockpitVisaoGeral");
    semNaVisao("CockpitHealthBar");
    naoImportado("cockpit-visao-geral", "cockpit-health-bar");
    expect(geralCodigo).not.toMatch(/\bHealth\b/);
  });

  it("ausente da Visao: Midia 30 dias", () => {
    semNaVisao("CockpitMidia");
    naoImportado("cockpit-cards");
    textoAusente("Mídia · 30 dias");
  });

  it("ausente da Visao: Negocio", () => {
    semNaVisao("CockpitNegocio");
    naoImportado("cockpit-cards");
    // Ticket 925 (spec 09/10): só a aba Comercial monta o Negócio, fora do ramo conta.
    expect(ocorrencias(ramoConta, "CockpitNegocio")).toEqual([]);
    expect(ocorrencias(ramoComercial, "CockpitNegocio").length).toBeGreaterThan(0);
    expect(ocorrencias(ramoPerformance, "CockpitNegocio")).toEqual([]);
  });

  it("ausente da Visao: Acao", () => {
    semNaVisao("CockpitAcao");
    naoImportado("cockpit-cards");
    expect(ocorrencias(pageCodigo, "CockpitAcao")).toEqual([]);
  });

  it("ausente da Visao: Resumo", () => {
    // o bloco antigo só monta atrás do link direto ?sub=resumo; fora dele o AnchorBlock fica sem filho
    expect(semCondicao(corpoDaVisao, "ResumoTab", guardaAba("resumo"))).toEqual([]);
    expect(ocorrencias(corpoDaVisao, "ResumoTab").length).toBe(1);
    expect(ramoVisao).toMatch(/<AnchorBlock id="resumo-antigo"[^>]*>\s*\{activeTab === "resumo" \? <ResumoTab[^]*?\/> : null\}\s*<\/AnchorBlock>/);
    for (const c of MONTADOS_NA_VISAO) expect(ocorrencias(semComentarios(fonte[c]), "ResumoTab"), c).toEqual([]);
    naoImportado("resumo-tab");
    expect(geralCodigo).not.toContain("ResumoTab");
  });

  it("ausente da Visao: Linha do tempo antiga", () => {
    // a única timeline montada na Visão é a timeline-visao
    const tags = todos(/<([A-Za-z]*Timeline[A-Za-z]*)(?![A-Za-z0-9_])/g, corpoDaVisao);
    expect(tags.filter((t) => t !== "TimelineVisao")).toEqual([]);
    expect(semCondicao(corpoDaVisao, "RegistrosTimelineTab", NUNCA)).toEqual([]);
    naoImportado("registros-tab");
    // Ticket 546: a aba Relação troca a lista antiga (RegistrosTimelineTab) pela
    // linha do tempo única (TimelineRelacao); o valor esperado veio do ticket:
    // a antiga some do ramo (lista vazia) e a nova monta pelo menos uma vez.
    expect(ocorrencias(semComentarios(recorte(page, RAMO_RELACAO, RAMO_CONTA)), "RegistrosTimelineTab")).toEqual([]);
    expect(ocorrencias(semComentarios(recorte(page, RAMO_RELACAO, RAMO_CONTA)), "TimelineRelacao").length).toBeGreaterThan(0);
  });

  it("ausente da Visao: Alertas de Performance antigos", () => {
    expect(semCondicao(corpoDaVisao, "AlertasClienteTab", guardaAba("alertas"))).toEqual([]);
    expect(ocorrencias(corpoDaVisao, "AlertasClienteTab").length).toBe(1);
    expect(ramoVisao).toMatch(/<AnchorBlock id="alertas-antigo"[^>]*>\s*\{activeTab === "alertas" \? <AlertasClienteTab[^]*?\/> : null\}\s*<\/AnchorBlock>/);
    for (const c of MONTADOS_NA_VISAO) expect(ocorrencias(semComentarios(fonte[c]), "AlertasClienteTab"), c).toEqual([]);
    naoImportado("alertas-cliente-tab");
    expect(geralCodigo).not.toContain("AlertasClienteTab");
  });

  it("ausente da Visao: Selecionar pacote e Iniciar onboarding com cliente ativo", () => {
    // o botão traz o seletor de pacote e a ação de iniciar
    const botao = lerArq(resolve(RAIZ, "src/components/onboarding/iniciar-onboarding-button.tsx"));
    expect(botao).toContain("Selecionar pacote");
    expect(botao).toMatch(/Iniciar onboarding/i);
    // toda montagem está atrás de !isClienteAtivo(...)
    expect(ocorrencias(corpoDaVisao, "IniciarOnboardingButton").length).toBe(1);
    expect(semCondicao(corpoDaVisao, "IniciarOnboardingButton", GUARDA_NAO_ATIVO)).toEqual([]);
    expect(pageCodigo).toContain("!isClienteAtivo(cliente?.status) && <IniciarOnboardingButton");
    // e a guarda é falsa para cliente ativo
    expect(isClienteAtivo("Ativo")).toBe(true);
    // nem o cartão nem a aba nem os blocos mencionam pacote ou onboarding-button
    expect(geralCodigo).not.toContain("IniciarOnboardingButton");
    textoAusente("Selecionar pacote");
    naoImportado("iniciar-onboarding-button");
    // e o cartão renderizado de um cliente ativo não traz nenhum dos dois textos
    const t = textoDe(cartao());
    expect(t).not.toContain("Selecionar pacote");
    expect(t).not.toMatch(/Iniciar onboarding/i);
  });
});

describe("copy", () => {
  const telas: [string, string][] = [
    ["geral-tab", geralCodigo],
    ...COMPONENTES.map((c): [string, string] => [c, semComentarios(fonte[c])]),
  ];

  it("copy: nenhum travessao na Visao e no cartao", () => {
    const achados = telas.filter(([, src]) => src.includes(" — ")).map(([nome]) => nome);
    expect(achados).toEqual([]);
    expect(cartao({ teses: TESES_3, entregaveis: ENTREGAVEIS_4_DE_7 })).not.toContain(" — ");
  });

  it("copy: nenhum s/ dado", () => {
    const achados = telas.filter(([, src]) => src.includes("s/ dado")).map(([nome]) => nome);
    expect(achados).toEqual([]);
    expect(textoDe(cartao())).not.toContain("s/ dado");
  });

  it("copy: Timeline vazia renderiza uma linha de estado vazio", () => {
    const TimelineVisaoView = carregar(caminhoComp("timeline-visao")).TimelineVisaoView as React.ComponentType<Record<string, unknown>>;
    const ok = { estado: "ok", itens: [] };
    const h = html(React.createElement(TimelineVisaoView, {
      cargas: { status: ok, reunioes: ok, alertas: ok, combinados: ok }, otimizacoes: [],
    }));
    // uma linha só: não uma por origem, nem card com heading no lugar do vazio
    expect(contar(h, /data-testid="timeline-sem-base"/g)).toBe(1);
    expect(contar(h, /data-testid="timeline-origem-sem-base"/g)).toBe(0);
    expect(contar(h, /<p[\s>]/g)).toBe(1);
    expect(h).not.toContain("<ul");
    // 650: vazio nunca é heading (antes 1), e o texto é 'nenhum evento no período' em vez de 'sem base, nenhum evento'.
    expect(contar(h, /<h[1-6][\s>]/g)).toBe(0);
    expect(textoDe(h)).toContain("nenhum evento no período");
  });
});
