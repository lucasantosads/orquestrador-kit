  });

  it("cabecalho: chip de NPS", () => {
    expect(mockupCartao).toContain('id="npsChip"');
    const h = cartao();
    const el = /<button[^>]*data-testid="nps-chip"[^>]*>([^]*?)<\/button>/.exec(h);
    expect(el, "botão nps-chip não renderizado no cartão").not.toBeNull();
    const texto = textoDe(el![1]);
    expect(texto).toMatch(/^NPS( -?[0-9]{1,3}| · sem base)?$/);
    // 29/09: o chip abre o popover com as ações do link (Copiar e Regenerar); a Dica diz isso.
    expect(h).toMatch(/<span[^>]*data-dica="Ver ações do link de NPS"[^>]*>(?:(?!<\/span>)[^])*<button[^>]*data-testid="nps-chip"/);
  });

  it("cabecalho: chip de saude com fonte unica do 296", () => {
    expect(mockupCartao).not.toContain("Saúde");
    const h = cartao();
    const el = /data-testid="chip-saude"[^>]*>([^<]*(?:<span[^>]*>[^<]*<\/span>[^<]*)*)<\/span>/.exec(h);
    expect(el, "chip-saude não renderizado").not.toBeNull();
    // Ticket 711b3: o rótulo vem de chipSaude (cor verde = "Saúde · Verde"), não mais "Saúde 78/100".
    expect(textoDe(el![1]).replace(/\s+/g, "")).toBe("Saúde·Verde");
    // Ticket 711b3: o shell resolve o chip uma única vez pela regra do Início (lerSinalCliente)
    expect(page).toContain("chip={chipSaude}");
    expect(page).toContain("lerSinalCliente(String(id))");
    expect(contar(page, /fetch\(`\/api\/perf\/cockpit\//g)).toBe(1);
    // sem segundo fetch de /api/perf/cockpit no cartão nem nos componentes montados na Visão
    expect(geralCodigo).not.toContain("/api/perf/cockpit");
    for (const c of MONTADOS_NA_VISAO.filter((x) => x !== "analise-ia")) {
      expect(semComentarios(fonte[c]), c).not.toContain("/api/perf/cockpit");
    }
    // analise-ia lê o mesmo endpoint só para a última análise (acao.ultima_analise_ia), nunca o score
    const ia = semComentarios(fonte["analise-ia"]);
    expect(ia).toContain("acao?: { ultima_analise_ia?");
    expect(ia).not.toMatch(/health|saude|score/i);
    expect(corpoCartao).not.toContain("fetchJson<{ health");
    // e o cartão sem base diz "sem base", nunca um número
    // Ticket 711b3: sem item na rota de sinais, chipSaude(null) devolve o rótulo "Saúde · sem base".
    expect(textoDe(cartao({}, chipSaude(null)))).toContain("Saúde · sem base");
  });

  it("cabecalho: badge de renovacao ou sem base", () => {
    expect(mockupCartao).toContain('id="renov"');
    // com fidelidade_fim dentro de 45 dias: o badge existe e o texto casa
    const com = cartao({ contratoData: { fidelidade_fim: diaIso(12) } });
    const el = /<[^>]*data-testid="badge-renovacao"[^>]*>([^<]*)</.exec(com);
    expect(el, "badge-renovacao não renderizado").not.toBeNull();
    expect(el![1].trim()).toMatch(/^(Renova em [0-9]+ dias?|Renova hoje|Fidelidade vencida)$/);
    expect(el![1].trim()).toBe("Renova em 12 dias");
    // sem contratoData (e além de 45 dias): nenhum badge com número, nenhum 0, nenhum travessão no lugar
