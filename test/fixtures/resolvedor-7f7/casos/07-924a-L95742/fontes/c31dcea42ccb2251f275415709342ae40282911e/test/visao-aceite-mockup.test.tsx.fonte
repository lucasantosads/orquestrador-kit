// ─── Carregador de módulos reais (esbuild + vm) ─────────────────────────────
type Overrides = Record<string, unknown>;
const cache = new Map<string, Record<string, unknown>>();

function nomeDoImportDinamico(loader: unknown): string {
  const m = /(?:import|require)\("([^"]+)"\)/.exec(String(loader));
  return m ? m[1].split("/").pop() ?? "" : "";
}
/** next/dynamic: renderiza um marcador com o nome do módulo e os filhos (a Dica vira <span data-dica>). */
const dynamicStub = {
  __esModule: true,
  default: (loader: unknown) => {
    const nome = nomeDoImportDinamico(loader);
    return function Dinamico(props: Record<string, unknown>) {
      return React.createElement(
        "span",
        { "data-dinamico": nome, "data-dica": typeof props.texto === "string" ? props.texto : undefined },
        props.children as React.ReactNode,
      );
    };
  },
};

function carregar(arquivo: string, overrides: Overrides = {}): Record<string, unknown> {
  const chave = `${arquivo}|${Object.keys(overrides).join(",")}`;
  const pronto = cache.get(chave);
  if (pronto) return pronto;
  const { code } = transformSync(lerArq(arquivo), {
    loader: arquivo.endsWith(".tsx") ? "tsx" : "ts", jsx: "automatic", format: "cjs", target: "node18", sourcefile: arquivo,
  });
  const mod = new Module(arquivo, module);
  mod.filename = arquivo;
  mod.paths = (Module as unknown as { _nodeModulePaths(dir: string): string[] })._nodeModulePaths(dirname(arquivo));
  cache.set(chave, mod.exports);
  const req = (id: string): unknown => {
    if (id in overrides) return overrides[id];
    const base = id.startsWith("@/") ? resolve(RAIZ, "src", id.slice(2)) : id.startsWith(".") ? resolve(dirname(arquivo), id) : null;
    if (!base) return mod.require(id);
    for (const ext of [".tsx", ".ts"]) {
      try { lerArq(base + ext); } catch { continue; }
      return carregar(base + ext, overrides);
    }
    return mod.require(id);
  };
  const wrapper = vm.runInThisContext(Module.wrap(code), { filename: arquivo });
  wrapper.call(mod.exports, mod.exports, req, mod, arquivo, dirname(arquivo));
  cache.set(chave, mod.exports);
  return mod.exports;
}

const sonnerStub = { toast: { success() {}, error() {} } };
const linkStub = {
  __esModule: true,
  default: (p: { href: string; children?: React.ReactNode }) => React.createElement("a", { href: p.href }, p.children),
};
const html = (el: React.ReactElement): string => renderToStaticMarkup(el);
const contar = (src: string, re: RegExp): number => (src.match(re) || []).length;

// ─── Cartão do topo (IdentidadeCliente) renderizado ─────────────────────────
interface FichaOverrides {
  contratoData?: { fidelidade_fim: string } | null;
  npsToken?: string | null;
  fechamento?: Record<string, unknown> | null;
  teses?: unknown[];
  entregaveis?: { progresso: number }[];
}
let fichaAtual: Record<string, unknown> = {};
const geralMod = carregar(GERAL_PATH, {
  "next/dynamic": dynamicStub,
