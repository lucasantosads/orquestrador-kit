  });

  it("cabecalho: gestor", () => {
    expect(mockupCartao).toContain("Gestor <b>");
    // RECALCULA (ticket 648): o rótulo renderizado usa ponto médio, "Gestor · Fernando".
    expect(textoDe(cartao())).toMatch(/Gestor ·\s*Fernando/);
