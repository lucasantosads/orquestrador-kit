/** Remove comentários de linha e de bloco: comentário não é tela. `://` de URL sobrevive. */
function semComentarios(src: string): string {
  return src.replace(/\/\*[^]*?\*\//g, "").replace(/(^|\s)\/\/[^\n]*/g, "$1");
}
const geralCodigo = semComentarios(geral);
const pageCodigo = semComentarios(page);

/** Recorte [ini, fim) por marcadores; marcador ausente derruba o teste com mensagem. */
function recorte(src: string, ini: string, fim?: string): string {
  const i = src.indexOf(ini);
  if (i < 0) throw new Error(`marcador não encontrado: ${ini}`);
  const f = fim === undefined ? src.length : src.indexOf(fim, i + ini.length);
  if (f < 0) throw new Error(`marcador não encontrado: ${fim}`);
  return src.slice(i, f);
}
const RAMO_VISAO = 'grupoAtivo === "visao-geral" &&';
const RAMO_PERF = 'grupoAtivo === "performance" &&';
const RAMO_RELACAO = 'grupoAtivo === "relacao" &&';
const RAMO_CONTA = 'grupoAtivo === "conta" &&';
const ramoVisao = semComentarios(recorte(page, RAMO_VISAO, RAMO_PERF));
const ramoPerformance = semComentarios(recorte(page, RAMO_PERF, RAMO_RELACAO));
const RAMO_COMERCIAL = 'grupoAtivo === "comercial" &&';
const ramoConta = semComentarios(recorte(page, RAMO_CONTA, RAMO_COMERCIAL));
// Ticket 925 (spec 09/10): Fechamentos e Negócio foram para a aba Comercial.
