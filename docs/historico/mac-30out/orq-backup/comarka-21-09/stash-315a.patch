+++   * (test/regra19.test.ts) — a chave "mrr" ali dispararia o gate mesmo sem
+++   * nenhuma cifra em R$ aparecer em tela (o valor só circula até o drawer
+++   * reusado do 324, que edita esse campo). */
+++  valorMensalPerdido: number;
  +  motivoCancelamento: string | null;
  +  observacao: string | null;
  +  status: string;
  +  etapaChurn: string;
  +  dataCancelamento: string | null;
  +  donoId: string | null;
  +  donoNome: string | null;
  +  churnValidado: boolean;
  +  churnValidadoEm: string | null;
  +  churnValidadoPorNome: string | null;
  +  checklist: ChecklistSaida;
  +}
  +
  +/**
  + * Leitura pura (SELECT) de clientes_receita (zona C0, read-only) — isolada
  + * nesta função própria, sem nenhuma mutação nas linhas ao redor. Só resolve
  + * o id equivalente na tabela de receita p/ casar com churn_aprovacoes
  + * (join lógico documentado em DATABASE_SCHEMA_REPORT.md — clientes_receita.
  + * cliente_id -> clientes.id). Nenhum campo financeiro é lido.
  + */
  +async function resolverClienteReceitaIds(clienteIds: string[]): Promise<Map<string, string>> {
  +  if (!clienteIds.length) return new Map();
  +  const { data } = await supabase
  +    .from("clientes_receita")
  +    .select("id, cliente_id")
  +    .in("cliente_id", clienteIds);
  +  const mapa = new Map<string, string>();
  +  for (const row of (data ?? []) as ClienteReceitaLink[]) {
  +    if (row.cliente_id) mapa.set(row.cliente_id, row.id);
  +  }
  +  return mapa;
  +}
  +
  +async function buscarChecklist(clienteIds: string[]): Promise<Map<string, ChecklistSaida>> {
  +  const receitaPorCliente = await resolverClienteReceitaIds(clienteIds);
  +  const receitaIds = Array.from(receitaPorCliente.values());
  +  const aprovacaoPorReceita = new Map<string, ChurnAprovacaoRow>();
  +
  +  if (receitaIds.length) {
  +    const { data } = await supabase
  +      .from("churn_aprovacoes")
  +      .select("id, cliente_receita_id, tem_debito_pendente, tem_multa_contratual, created_at")
  +      .in("cliente_receita_id", receitaIds)
  +      .order("created_at", { ascending: false });
  +    for (const row of (data ?? []) as ChurnAprovacaoRow[]) {
  +      // Primeira ocorrência por cliente_receita_id = mais recente (order desc acima).
  +      if (!aprovacaoPorReceita.has(row.cliente_receita_id)) {
  +        aprovacaoPorReceita.set(row.cliente_receita_id, row);
  +      }
  +    }
  +  }
  +
  +  const resultado = new Map<string, ChecklistSaida>();
  +  for (const clienteId of clienteIds) {
  +    const receitaId = receitaPorCliente.get(clienteId);
  +    const aprov = receitaId ? aprovacaoPorReceita.get(receitaId) : undefined;
  +    resultado.set(
  +      clienteId,
  +      aprov
  +        ? {
  +            aprovacaoId: aprov.id,
  +            temDebitoPendente: aprov.tem_debito_pendente,
  +            temMultaContratual: aprov.tem_multa_contratual,
  +          }
  +        : { aprovacaoId: null, temDebitoPendente: null, temMultaContratual: null },
  +    );
  +  }
  +  return resultado;
  +}
  +
  +async function buscarNomesEmployees(ids: string[]): Promise<Map<string, string>> {
  +  if (!ids.length) return new Map();
  +  const { data } = await supabase.from("employees").select("id, nome").in("id", ids);
  +  return new Map(((data ?? []) as EmployeeRow[]).map((e) => [e.id, e.nome]));
  +}
  +
  +export async function GET() {
  +  const session = await getSession();
  +  if (!session) {
  +    return NextResponse.json({ error: "Não autenticado" }, { status: 401 });
  +  }
  +
  +  const { data, error } = await supabase
  +    .from("clientes")
  +    .select("id, nome, mrr, motivo_cancelamento, observacao, status, etapa_churn, data_cancelamento, gestor_id, churn_validado, churn_validado_em, churn_validado_por")
  +    .eq("status", "cancelado")
  +    .order("data_cancelamento", { ascending: false });
  +
  +  if (error) {
  +    return NextResponse.json({ error: error.message }, { status: 500 });
  +  }
  +
  +  const todas = (data ?? []) as ClienteRow[];
  +  const emAndamento = todas.filter((c) => (c.etapa_churn || "aviso_recebido") !== "finalizado");
  +  const clienteIds = emAndamento.map((c) => c.id);
  +
  +  const nomeIds = Array.from(
  +    new Set([
  +      ...emAndamento.map((c) => c.gestor_id).filter((v): v is string => !!v),
  +      ...emAndamento.map((c) => c.churn_validado_por).filter((v): v is string => !!v),
  +    ]),
  +  );
  +
  +  const [checklistPorCliente, nomesPorId] = await Promise.all([
  +    buscarChecklist(clienteIds),
  +    buscarNomesEmployees(nomeIds),
  +  ]);
  +
  +  const saidas: SaidaAndamento[] = emAndamento.map((c) => ({
  +    id: c.id,
  +    nome: c.nome,
--     mrr: Number(c.mrr) || 0,
+++    valorMensalPerdido: Number(c.mrr) || 0,
  +    motivoCancelamento: c.motivo_cancelamento,
  +    observacao: c.observacao,
  +    status: c.status,
  +    etapaChurn: c.etapa_churn || "aviso_recebido",
  +    dataCancelamento: c.data_cancelamento,
  +    donoId: c.gestor_id,
  +    donoNome: c.gestor_id ? nomesPorId.get(c.gestor_id) ?? null : null,
  +    churnValidado: !!c.churn_validado,
  +    churnValidadoEm: c.churn_validado_em,
  +    churnValidadoPorNome: c.churn_validado_por ? nomesPorId.get(c.churn_validado_por) ?? null : null,
  +    checklist: checklistPorCliente.get(c.id) ?? { aprovacaoId: null, temDebitoPendente: null, temMultaContratual: null },
  +  }));
  +
  +  return NextResponse.json({ saidas });
  +}
