  +/**
  + * GET /api/churn/saidas
  + *
  + * "Saídas em andamento" (ticket 315a) — clientes.status='cancelado' AND
  + * etapa_churn<>'finalizado': procedimento de saída já decidido na receita,
  + * não retenção (todos já churned; ver docs/fila/315a-*.md). Junta:
  + *   - dono: clientes.gestor_id -> employees.nome (sem dono quando nulo);
  + *   - checklist de saída: churn_aprovacoes.tem_debito_pendente/
  + *     tem_multa_contratual, casado por cliente_receita_id (nunca por nome) —
  + *     ausência de aprovação registrada devolve null (sem base), nunca um
  + *     falso "ok").
  + *
  + * Escrita do checklist é em PATCH /api/churn/checklist; validação final
  + * (churn_validado/_em/_por) em PATCH /api/churn/validar. Esta rota só lê.
  + */
  +import { NextResponse } from "next/server";
  +import { createClient } from "@supabase/supabase-js";
  +import { getSession } from "@/lib/session";
  +
  +const supabase = createClient(
  +  process.env.NEXT_PUBLIC_SUPABASE_URL || "https://placeholder.supabase.co",
  +  process.env.SUPABASE_SERVICE_ROLE_KEY || "placeholder",
  +);
  +
  +interface ClienteRow {
  +  id: string;
  +  nome: string;
  +  mrr: number | null;
  +  motivo_cancelamento: string | null;
  +  observacao: string | null;
  +  status: string;
  +  etapa_churn: string | null;
  +  data_cancelamento: string | null;
  +  gestor_id: string | null;
  +  churn_validado: boolean | null;
  +  churn_validado_em: string | null;
  +  churn_validado_por: string | null;
  +}
  +
  +interface EmployeeRow {
  +  id: string;
  +  nome: string;
  +}
  +
  +interface ClienteReceitaLink {
  +  id: string;
  +  cliente_id: string | null;
  +}
  +
  +interface ChurnAprovacaoRow {
  +  id: string;
  +  cliente_receita_id: string;
  +  tem_debito_pendente: boolean | null;
  +  tem_multa_contratual: boolean | null;
  +  created_at: string | null;
  +}
  +
  +export interface ChecklistSaida {
  +  aprovacaoId: string | null;
  +  temDebitoPendente: boolean | null;
  +  temMultaContratual: boolean | null;
  +}
  +
  +export interface SaidaAndamento {
  +  id: string;
  +  nome: string;
--   mrr: number;
+++  /** Nomeado sem "mrr" de propósito: o consumidor (saide-em-andamento.tsx)
