  +/**
  + * Ticket 324 — "+ N mais" no kanban de churn: a coluna só mostra os primeiros
  + * `limit` clientes por padrão; o botão "+ N mais" expande a coluna inteira e o
  + * contador some. Extraído para função pura para poder ser testado sem
  + * precisar montar a página inteira (que tem fetch + estado de loading).
  + */
  +export function visibleClientes<T>(items: T[], expanded: boolean, limit = 5): T[] {
  +  return expanded ? items : items.slice(0, limit);
  +}
  +
  +export function restantes<T>(items: T[], limit = 5): number {
  +  return Math.max(0, items.length - limit);
  +}
  +
  +/**
  + * Shape do cliente no pipeline de churn (fonte: `clientes`), compartilhado
  + * entre o kanban legado (page.tsx) e o drawer extraído (ticket 315a —
  + * cliente-drawer.tsx), reusado por sua vez na tela de "Saídas em andamento"
  + * de Saúde/Retenção.
  + */
  +export interface ClienteChurn {
  +  id: string;
  +  nome: string;
  +  mrr: number;
  +  motivo_cancelamento: string | null;
  +  data_cancelamento: string | null;
  +  etapa_churn: string;
  +  status: string;
  +  observacao: string | null;
  +}
  +
  +export interface EtapaChurnConfig {
  +  key: string;
  +  label: string;
  +  color: string;
  +  bg: string;
  +  border: string;
  +  badge: string;
  +  icon: string;
  +}
  +
  +/** Config das 5 etapas do pipeline — única fonte, evita divergência entre kanban e drawer. */
  +export const ETAPAS_CHURN: EtapaChurnConfig[] = [
  +  { key: "aviso_recebido", label: "Aviso de Saida", color: "var(--danger)", bg: "bg-red-500/10", border: "border-red-500/30", badge: "bg-red-500/15 text-red-400", icon: "📩" },
  +  { key: "juridico", label: "Juridico", color: "var(--muted-foreground)", bg: "bg-neutral-500/10", border: "border-neutral-500/30", badge: "bg-neutral-500/15 text-neutral-400", icon: "⚖️" },
  +  { key: "no_prazo_aviso", label: "No Prazo do Aviso", color: "var(--warn)", bg: "bg-orange-500/10", border: "border-orange-500/30", badge: "bg-orange-500/15 text-orange-400", icon: "⏳" },
  +  { key: "procedimentos_finais", label: "Procedimentos Finais", color: "var(--info)", bg: "bg-blue-500/10", border: "border-blue-500/30", badge: "bg-blue-500/15 text-blue-400", icon: "📋" },
  +  { key: "finalizado", label: "Finalizado", color: "var(--success)", bg: "bg-emerald-500/10", border: "border-emerald-500/30", badge: "bg-emerald-500/15 text-emerald-400", icon: "✅" },
  +];
  +
  +const PRAZO_SAIDA_DIAS = 30;
  +
  +/**
  + * Dias corridos desde `dataIso` até `hojeIso` (ambos YYYY-MM-DD, ancorados ao
  + * meio-dia p/ não sofrer com DST). Ticket 315a: usado tanto pro "dias desde o
  + * aviso" quanto pro prazo — D24 não se aplica aqui, o prazo de saída é fixo
  + * em 30 dias a partir da data de cancelamento (o "aviso").
  + */
  +export function diasDesdeAviso(dataIso: string, hojeIso: string): number {
  +  const d = new Date(`${dataIso}T12:00:00`).getTime();
  +  const h = new Date(`${hojeIso}T12:00:00`).getTime();
  +  return Math.ceil((h - d) / 86400000);
  +}
  +
  +/** Dias restantes do prazo de 30 dias (negativo = vencido há N dias). */
  +export function prazoRestanteDias(diasDesde: number): number {
  +  return PRAZO_SAIDA_DIAS - diasDesde;
  +}
