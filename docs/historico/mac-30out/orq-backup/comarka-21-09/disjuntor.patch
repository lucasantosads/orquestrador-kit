+# --- DISJUNTOR DE RETRY SEM PROGRESSO (21/09) --------------------------------
+# $vistos só vale dentro de UMA drenagem: no disparo seguinte o mesmo ticket
+# volta a ser escolhido. Incidente 440: 19 execuções entre 18/09 e 21/09, todas
+# com attempt vazio (o executor saía no `git worktree add` antes do agente) e
+# nada parava a repetição. Este contador PERSISTE entre disparos, em
+# runs/<id>/.sem-progresso ("N|primeira|ultima"), e só conta o ramo "segue
+# pendente sem cooldown (sem progresso)". Adiamento (cooldown armado, ou
+# 529/500/503 que adia sem cooldown) não conta. Zera quando o ticket muda de
+# status ou quando staging-auto avança na vez dele. Limite na chave
+# disjuntor_sem_progresso_limite do 000-config.json (ausente => 3).
+sem_progresso_arquivo() { echo "$RUNS_BASE/$1/.sem-progresso"; }
+sem_progresso_zerar()   { rm -f "$(sem_progresso_arquivo "$1")"; }
+# sem_progresso_incrementar <id> -> imprime "N|primeira|ultima" já gravado.
+sem_progresso_incrementar() {
+  local f n=0 primeira agora linha
+  f="$(sem_progresso_arquivo "$1")"; agora="$(ts)"; primeira="$agora"
+  if [ -f "$f" ]; then
+    linha="$(cat "$f")"
+    n="${linha%%|*}"; primeira="$(printf '%s' "$linha" | cut -d'|' -f2)"
+    case "$n" in ''|*[!0-9]*) n=0; primeira="$agora" ;; esac
+  fi
+  n=$((n+1)); mkdir -p "$(dirname "$f")"
+  printf '%s|%s|%s\n' "$n" "$primeira" "$agora" > "$f"
+  cat "$f"
+}
+disjuntor_limite() {
+  local l; l="$(cfg '.disjuntor_sem_progresso_limite // 3' 2>/dev/null || echo 3)"
+  case "$l" in ''|*[!0-9]*|0) l=3 ;; esac
+  echo "$l"
+}
+# disjuntor_causa <saida-do-executor> -> última linha de erro (ou texto padrão).
+disjuntor_causa() {
+  local c; c="$(grep -E 'ERRO|fatal:|[Ee]rro[ r:]|FAIL' "$1" 2>/dev/null | tail -1 | tr -d '\r' | cut -c1-300)"
+  echo "${c:-sem linha de erro na saida do executor}"
+}
