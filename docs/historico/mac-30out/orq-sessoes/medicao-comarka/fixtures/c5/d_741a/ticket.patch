+/** Camada 3: a única escrita do arquivo. Um upsert por avaliação 'gravar'. */
+export async function gravarPromessas(db: Db, avaliacoes: AvaliacaoPromessa[]): Promise<{ gravadas: number; falhas: number }> {
+  let gravadas = 0;
+  let falhas = 0;
+  for (const a of avaliacoes) {
+    if (a.decisao !== "gravar" || !a.linha) continue;
+    try {
+      const { error } = await db.from("perf_promessas").upsert(a.linha, { onConflict: "wpp_message_id", ignoreDuplicates: true });
+      if (error) falhas++;
+      else gravadas++;
     } catch {
-      resumo.falhas++;
+      falhas++;
     }
   }
-  return resumo;
+  return { gravadas, falhas };
+}
