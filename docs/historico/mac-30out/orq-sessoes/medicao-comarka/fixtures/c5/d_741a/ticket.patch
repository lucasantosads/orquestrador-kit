+export async function detectarPromessas(db: Db, agoraISO: string, teto: number = TETO_CHAMADAS): Promise<ResumoPromessas> {
+  const desdeISO = new Date(Date.parse(agoraISO) - JANELA_HORAS * MS_HORA).toISOString();
+  const insumo = await carregarInsumoPromessas(db, { desdeISO, ateISO: agoraISO });
+  const avaliacoes = await avaliarCandidatos(insumo, chamarProvider, teto);
+  const gravacao = await gravarPromessas(db, avaliacoes);
+  const conta = (d: AvaliacaoPromessa["decisao"]) => avaliacoes.filter((a) => a.decisao === d).length;
+  return {
+    candidatos: avaliacoes.length,
+    chamadas: avaliacoes.length - conta("fora_do_teto"),
+    gravadas: gravacao.gravadas,
+    descartadas: conta("descartar"),
+    falhas: conta("falha") + gravacao.falhas,
+  };
