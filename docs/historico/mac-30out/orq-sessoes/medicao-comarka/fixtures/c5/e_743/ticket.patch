+/**
+ * União (sem repetir) das etapas atuais e das etapas de destino do histórico
+ * das oportunidades do contato: "atingiu" = esteve na etapa alguma vez.
+ * Erro de leitura sobe; nunca vira lista vazia.
+ */
+export async function carregarEtapasAtingidas(clienteId: string, ghlContactId: string): Promise<string[]> {
+  const { data: oportunidades, error: errOp } = await supabase
+    .from("perf_crm_oportunidades")
+    .select("id, etapa_id")
+    .eq("cliente_id", clienteId)
+    .eq("ghl_contact_id", ghlContactId);
+
+  if (errOp) {
+    throw new Error(`Falha ao ler oportunidades do contato: ${errOp.message}`);
+  }
+  const ops: { id: string; etapa_id: string | null }[] = Array.isArray(oportunidades) ? oportunidades : [];
+  if (ops.length === 0) return [];
+
+  const { data: historico, error: errHist } = await supabase
+    .from("perf_crm_oportunidade_historico")
+    .select("etapa_para_id")
+    .in("oportunidade_id", ops.map((o) => o.id));
+
+  if (errHist) {
+    throw new Error(`Falha ao ler historico das oportunidades do contato: ${errHist.message}`);
+  }
+
+  const ids: string[] = [];
+  for (const o of ops) if (o.etapa_id) ids.push(o.etapa_id);
+  const hist: { etapa_para_id: string | null }[] = Array.isArray(historico) ? historico : [];
+  for (const h of hist) {
+    if (h.etapa_para_id) ids.push(h.etapa_para_id);
+  }
+  return Array.from(new Set(ids));
+}
