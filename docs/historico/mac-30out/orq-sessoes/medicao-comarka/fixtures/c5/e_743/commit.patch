+/** Grava mudou_etapa quando a fase atual difere da última registrada (idas e vindas). */
+async function registrarPassagem(lead: LeadParaQualificar, regras: RegraQualificacao[]): Promise<void> {
+  const fase = faseAtualDoLead(lead, regras);
+  if (fase === null) return;
+
+  const { data: ultimo, error: errUlt } = await supabase
+    .from("perf_lead_eventos")
+    .select("payload")
+    .eq("lead_id", lead.id)
+    .eq("tipo", "mudou_etapa")
+    .order("at", { ascending: false })
+    .limit(1)
+    .maybeSingle();
+  if (errUlt) throw new Error(`Falha ao ler a ultima passagem do lead: ${errUlt.message}`);
+
+  const anterior = (ultimo?.payload as { fase_para?: string } | null)?.fase_para ?? null;
+  if (!houvePassagem(anterior, fase)) return;
+
+  const { error: errIns } = await supabase.from("perf_lead_eventos").insert({
+    lead_id: lead.id,
+    tipo: "mudou_etapa",
+    payload: { fase_de: anterior, fase_para: fase, etapa_ids: lead.etapas_atuais ?? [], origem: "motor" },
+    at: new Date().toISOString(),
+  });
+  if (errIns) throw new Error(`Falha ao gravar a passagem do lead: ${errIns.message}`);
+}
