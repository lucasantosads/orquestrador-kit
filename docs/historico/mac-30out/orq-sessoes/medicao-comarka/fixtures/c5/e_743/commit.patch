+// -------------------------------------------------------
+// Fase atual — histórico de idas e vindas em perf_lead_eventos
+// -------------------------------------------------------
+export type FaseLead = "MQL" | "RM" | "RR" | "VENDA" | "PERDIDO";
+const ORDEM_FASE: FaseLead[] = ["MQL", "RM", "RR", "VENDA"];
+
+/**
+ * Fase em que o lead está agora pelas etapas das oportunidades vivas e as regras
+ * crm_ghl: a mais adiantada entre as etapas atuais; PERDIDO se desqualificado/perdido.
+ * null quando o lead não tem regra crm_ghl ou não está em etapa mapeada.
+ */
+export function faseAtualDoLead(lead: LeadParaQualificar, regras: RegraQualificacao[]): FaseLead | null {
+  const vencedoras = resolverRegras(lead.cliente_id, lead.tese_id, regras).filter((r) => r.tipo_regra === "crm_ghl");
+  if (vencedoras.length === 0) return null;
+  if (leadBloqueado(lead, vencedoras)) return "PERDIDO";
+  const atuais = Array.isArray(lead.etapas_atuais) ? lead.etapas_atuais : [];
+  let fase: FaseLead | null = null;
+  for (const r of vencedoras) {
+    const i = ORDEM_FASE.indexOf(r.classifica_como as FaseLead);
+    if (i < 0 || !idsDe(r.config?.etapa_ids).some((id) => atuais.includes(id))) continue;
+    if (fase === null || i > ORDEM_FASE.indexOf(fase)) fase = ORDEM_FASE[i];
+  }
+  return fase;
+}
+
+/** Passagem = o lead está numa fase e ela difere da última registrada. */
+export function houvePassagem(ultima: string | null, atual: FaseLead | null): atual is FaseLead {
+  return atual !== null && atual !== ultima;
+}
