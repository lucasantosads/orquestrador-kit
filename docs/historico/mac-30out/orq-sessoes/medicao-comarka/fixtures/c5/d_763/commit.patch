+function idDoItem(bruto: unknown): string | null {
+  const id = bruto && typeof bruto === "object" ? (bruto as { id?: unknown }).id : undefined;
+  return typeof id === "string" ? id : null;
+}
+
+/**
+ * Grava um lote de oportunidades em paralelo e requalifica cada contato do lote uma vez.
+ * Erro fora dos dois previstos (sem etapa, sem conexão) sobe depois do lote assentar: a página é
+ * refeita do último checkpoint, sem perda (gravação idempotente).
+ */
+async function gravarLoteOportunidades(
+  p: PayloadBackfill,
+  lote: unknown[],
+): Promise<{ processados: number; falhas: number; vistos: string[] }> {
+  let processados = 0;
+  let falhas = 0;
+  const vistos: string[] = [];
+  const contatos = new Set<string>();
+  let inesperado: unknown = null;
+
+  const resultados = await Promise.allSettled(
+    lote.map(async (bruto) => {
+      const opp = normalizarOportunidadeGhl(bruto);
+      if (!opp) return { opp: null, gravada: null };
+      return { opp, gravada: await gravarOportunidade(p.location_id, opp, "backfill") };
+    }),
+  );
+  resultados.forEach((res, i) => {
+    const id = idDoItem(lote[i]);
+    if (res.status === "fulfilled") {
+      if (!res.value.opp) falhas++;
+      else {
+        processados++;
+        if (res.value.gravada?.ghl_contact_id) contatos.add(res.value.gravada.ghl_contact_id);
+      }
+      if (id) vistos.push(id);
+      return;
+    }
+    const err = res.reason;
+    if (err instanceof OportunidadeSemEtapaError || err instanceof OportunidadeSemConexaoError) {
+      falhas++;
+      console.warn("[ghl-backfill] oportunidade nao gravada", id ?? "?", err.name);
+      if (id) vistos.push(id);
+    } else if (inesperado === null) inesperado = err;
+  });
+  if (inesperado !== null) throw inesperado;
+
+  const requal = await Promise.allSettled(Array.from(contatos).map((c) => requalificarContato(p.cliente_id, c)));
+  requal.forEach((res) => {
+    if (res.status === "rejected") {
+      falhas++;
+      console.error("[ghl-backfill] requalificar contato falhou", motivoDe(res.reason));
+    }
+  });
+  return { processados, falhas, vistos };
 }
 
