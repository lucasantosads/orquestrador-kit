+/**
+ * Espelha o último checkpoint em perf_crm_conexoes.sync_cursor (JSON da fase que salvou por último),
+ * para quem olha a conexão ver onde o backfill está sem ler ops_jobs. A retomada continua lendo o
+ * payload do job (cada fase tem o seu); falha aqui só loga, como o checkpoint.
+ */
+async function gravarSyncCursor(db: JobsDb, payload: Record<string, unknown>): Promise<void> {
+  const locationId = typeof payload.location_id === "string" ? payload.location_id : null;
+  if (!locationId) return;
+  const espelho = {
+    fase: payload.fase,
+    passo: payload.passo,
+    cursor: payload.cursor ?? null,
+    processados: payload.processados,
+    falhas: payload.falhas,
+    ...(typeof payload.total === "number" ? { total: payload.total } : {}),
+    em: new Date().toISOString(),
+  };
+  const { error } = await db
+    .from("perf_crm_conexoes")
+    .update({ sync_cursor: JSON.stringify(espelho) })
+    .eq("location_id", locationId);
+  if (error) console.error("[ghl-backfill] sync_cursor nao gravado:", error.message);
+}
